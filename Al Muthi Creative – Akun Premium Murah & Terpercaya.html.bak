function initPricingTable() {
  const list   = document.getElementById('price-list');
  const noRes  = document.getElementById('no-results');
  const search = document.getElementById('price-search');
  const tabs   = document.querySelectorAll('.price-tab');
  let activeCat = 'all';

  function render(filter) {
    const q = filter.toLowerCase();
    const cat = activeCat;
    const items = pricingData.filter(i =>
      (cat === 'all' || i.cat === cat) &&
      (i.name.toLowerCase().includes(q) || i.desc.toLowerCase().includes(q))
    );
    list.innerHTML = items.map(i => `
      <div class="price-item stagger-in shine-wrap">
        <div class="flex items-center gap-2.5 min-w-0">
          <span style="font-size:1.25rem;flex-shrink:0;">${i.emoji}</span>
          <div class="min-w-0">
            <p class="font-bold text-slate-800 text-sm leading-tight">${i.name}</p>
            <p class="text-xs text-slate-400 mt-0.5 truncate">${i.desc}</p>
          </div>
        </div>
        <div style="display:flex;align-items:center;gap:.5rem;flex-shrink:0;">
          <span style="font-weight:800;font-size:.9rem;color:#0284c7;white-space:nowrap;">${i.price}</span>
          <a href="https://order.amc.web.id" target="_blank" rel="noopener noreferrer"
             style="background:linear-gradient(135deg,#38bdf8,#0ea5e9);color:white;font-weight:700;font-size:.7rem;padding:.3rem .75rem;border-radius:9999px;text-decoration:none;white-space:nowrap;">Order</a>
        </div>
      </div>
    `).join('');
    noRes.classList.toggle('hidden', items.length > 0);
  }

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      activeCat = tab.dataset.cat;
      render(search ? search.value : '');
    });
  });
  if (search) search.addEventListener('input', () => render(search.value));
  render('');
}

// ── TESTIMONIALS ──
