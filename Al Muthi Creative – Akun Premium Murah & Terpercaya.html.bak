  <div class="absolute top-40 left-20 w-2 h-2 rounded-full bg-sky-400 section-dot opacity-30" style="--dur:4.5s;--delay:.5s;" aria-hidden="true"></div>

  <div class="container mx-auto px-4 max-w-7xl relative z-10">
