<body data-aos-easing="ease-out-cubic" data-aos-duration="650" data-aos-delay="0">

<div id="scroll-progress" aria-hidden="true" style="width: 0.382363%;"></div>
<div id="cursor-dot" aria-hidden="true"></div>
<div id="cursor-ring" aria-hidden="true"></div>

<!-- SKIP LINK -->
<a href="https://amc.web.id/#main-content" class="skip-link" style="position:absolute;top:-40px;left:6px;z-index:10000;background:#0284c7;color:white;padding:8px 16px;border-radius:8px;font-weight:700;font-size:.875rem;text-decoration:none;transition:top .2s;" onfocus="this.style.top='6px'" onblur="this.style.top='-40px'">Langsung ke konten</a>

<!-- NAVBAR -->
<nav class="site-nav" role="navigation" aria-label="Navigasi utama">
  <div class="nav-inner">
