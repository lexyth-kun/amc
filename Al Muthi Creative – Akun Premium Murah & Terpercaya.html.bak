  {name:'R***i M.',role:'Desainer',text:'CapCut Pro langsung aktif, fiturnya lengkap banget!'},
  {name:'Y***i B.',role:'Pelajar',text:'Spotify Premium-nya beneran worth it. CS juga helpful banget!'},
  {name:'T***a W.',role:'Pengusaha',text:'Zoom Pro buat meeting kantor. Prosesnya cuma 10 menit!'},
];

function initTestimonials() {
  const row1 = document.getElementById('marquee-row-1');
  const row2 = document.getElementById('marquee-row-2');
  if (!row1 || !row2) return;
  const half = Math.ceil(testimonials.length / 2);
  const t1 = testimonials.slice(0, half);
  const t2 = testimonials.slice(half);
  function card(t) {
    return `<div style="background:white;border:1.5px solid #e2e8f0;border-radius:1.5rem;padding:1.5rem;min-width:280px;max-width:320px;flex-shrink:0;">
      <div style="display:flex;gap:.25rem;margin-bottom:.75rem;">${'⭐'.repeat(5)}</div>
      <p style="color:#475569;font-size:.875rem;line-height:1.6;margin-bottom:.875rem;">"${t.text}"</p>
      <div style="display:flex;align-items:center;gap:.625rem;">
        <div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#38bdf8,#0ea5e9);display:flex;align-items:center;justify-content:center;color:white;font-size:.875rem;font-weight:700;flex-shrink:0;">${t.name[0]}</div>
        <div><p style="font-size:.8rem;font-weight:700;color:#0f172a;">${t.name}</p><p style="font-size:.7rem;color:#94a3b8;">${t.role}</p></div>
      </div>
    </div>`;
  }
  row1.innerHTML = [...t1,...t1].map(card).join('');
  row2.innerHTML = [...t2,...t2].map(card).join('');
}

// ── COUNTERS ──
function initCounters() {
  const counters = document.querySelectorAll('.counter-anim');
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        const el = e.target;
        const target = parseInt(el.dataset.target);
        const suffix = target >= 1000 ? 'K+' : '+';
        const display = target >= 1000 ? Math.round(target/1000) : target;
        let start = 0;
        const inc = display / 40;
        const timer = setInterval(() => {
          start += inc;
          if (start >= display) { el.textContent = display + suffix; clearInterval(timer); }
          else el.textContent = Math.floor(start) + suffix;
        }, 50);
        io.unobserve(el);
      }
    });
  }, { threshold: 0.3 });
  counters.forEach(el => io.observe(el));
}

// ── WA FORM ──
function initWAForm() {
  const form = document.getElementById('contact-whatsapp-form');
  if (!form) return;
  form.addEventListener('submit', e => {
    e.preventDefault();
    const nama     = document.getElementById('c-name')?.value || '';
    const wa       = document.getElementById('c-phone')?.value || '';
    const layanan  = document.getElementById('c-service')?.value || '';
    const catatan  = document.getElementById('c-note')?.value || '';
    const msg = encodeURIComponent(`Halo Al Muthi Creative, saya ingin konsultasi.\n\nNama: ${nama}\nNomor WhatsApp: ${wa}\nLayanan: ${layanan}\nCatatan: ${catatan}`);
    window.open(`https://wa.me/6285117120101?text=${msg}`, '_blank');
  });
}

// ── HAMBURGER ──
function initHamburger() {
  const btn  = document.getElementById('nav-hamburger');
  const menu = document.getElementById('mobile-menu');
  if (!btn || !menu) return;
  btn.addEventListener('click', () => {
    const open = btn.classList.toggle('open');
    menu.classList.toggle('open', open);
    btn.setAttribute('aria-expanded', open);
  });
  document.addEventListener('click', e => {
    if (!e.target.closest('nav')) {
      btn.classList.remove('open');
      menu.classList.remove('open');
      btn.setAttribute('aria-expanded', 'false');
    }
  });
  const sub = document.getElementById('mobile-sub-layanan-toggle');
  const subM = document.getElementById('mobile-sub-layanan');
  if (sub && subM) {
    sub.addEventListener('click', () => {
      const open = subM.style.display === 'flex';
      subM.style.display = open ? 'none' : 'flex';
      const arrow = sub.querySelector('.sub-arrow');
      if (arrow) arrow.style.transform = open ? '' : 'rotate(180deg)';
    });
  }
}

// ── SCROLL PROGRESS (requestAnimationFrame, lebih ringan) ──
const scrollProgressEl = document.getElementById('scroll-progress');
let scrollProgressTicking = false;
function updateScrollProgress() {
  if (!scrollProgressEl) return;
  const docH = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
  scrollProgressEl.style.width = (window.scrollY / docH * 100) + '%';
}
window.addEventListener('scroll', () => {
  if (scrollProgressTicking) return;
  scrollProgressTicking = true;
  requestAnimationFrame(() => {
    updateScrollProgress();
    scrollProgressTicking = false;
  });
}, { passive: true });
window.addEventListener('resize', updateScrollProgress, { passive: true });
updateScrollProgress();

// ── CURSOR ──
// Kursor memakai SVG arrow ringan via CSS. Tidak ada dot/ring custom agar halaman tetap smooth.

// ── FLIP CARDS MOBILE ──
document.addEventListener('DOMContentLoaded', () => {
  if (typeof AOS !== 'undefined') AOS.init({ once: true, duration: 650, offset: 32, easing: 'ease-out-cubic', disable: window.matchMedia('(max-width: 640px), (prefers-reduced-motion: reduce)').matches });
  if (typeof lucide !== 'undefined') lucide.createIcons();
  initPricingTable();
  initTestimonials();
  initCounters();
  initWAForm();
  initHamburger();

  document.querySelectorAll('.flip-card-wrap, .hero-flip-wrap').forEach(card => {
    card.addEventListener('click', e => {
      if (e.target.closest('a, button')) return;
      const was = card.classList.contains('flipped');
      document.querySelectorAll('.flip-card-wrap.flipped,.hero-flip-wrap.flipped').forEach(c => { if(c!==card) c.classList.remove('flipped'); });
      card.classList.toggle('flipped', !was);
    });
  });
  document.addEventListener('click', e => {
    if (!e.target.closest('.flip-card-wrap,.hero-flip-wrap')) {
      document.querySelectorAll('.flip-card-wrap.flipped,.hero-flip-wrap.flipped').forEach(c => c.classList.remove('flipped'));
    }
  });
});

// ── HERO THREE.JS (lazy load desktop only) ──
function initHeroThree() {
  const section = document.getElementById('hero-section');
  const canvas  = document.getElementById('hero-canvas');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const smallScreen = window.matchMedia('(max-width: 768px)').matches;
  if (!section || !canvas || typeof THREE === 'undefined' || reduceMotion || smallScreen) {
    if (canvas) canvas.remove();
    return;
  }
  const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: false, powerPreference: 'low-power' });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.35));
  renderer.setClearColor(0x000000, 0);
  const scene  = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(60, 1, 0.1, 100);
  camera.position.set(0, 0, 18);
  function resize() {
    const W = section.offsetWidth, H = section.offsetHeight;
    renderer.setSize(W, H); camera.aspect = W/H; camera.updateProjectionMatrix();
  }
  resize();
  let resizeTimer;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(resize, 120);
  }, { passive: true });
  let heroVisible = true;
  if ('IntersectionObserver' in window) {
    new IntersectionObserver(e => { heroVisible = e[0].isIntersecting; }, {threshold:.05}).observe(section);
  }
  const matWire  = new THREE.MeshBasicMaterial({color:0x38bdf8,wireframe:true,transparent:true,opacity:0.35});
  const matSolid = new THREE.MeshBasicMaterial({color:0x0ea5e9,transparent:true,opacity:0.08});
  const matRing  = new THREE.MeshBasicMaterial({color:0x7dd3fc,wireframe:true,transparent:true,opacity:0.45});
  const matDot   = new THREE.MeshBasicMaterial({color:0x0284c7,transparent:true,opacity:0.55});
  const objects = [];
  function addObj(geo, mat, x, y, z) {
    const m = new THREE.Mesh(geo, mat.clone ? mat.clone() : mat);
    m.position.set(x, y, z); scene.add(m); return m;
  }
  const torus1 = addObj(new THREE.TorusGeometry(3.5,.12,16,80), matRing, -9,1,-2); torus1._spin={x:.003,y:.005,z:.002}; objects.push(torus1);
  const torus2 = addObj(new THREE.TorusGeometry(2.2,.10,12,60), matRing, 9,-2,-1); torus2._spin={x:-.004,y:.003,z:-.002}; objects.push(torus2);
  const ico1   = addObj(new THREE.IcosahedronGeometry(1.8,0), matWire, -7,4,-3); ico1._spin={x:.006,y:.008,z:.003}; objects.push(ico1);
  const ico1s  = addObj(new THREE.IcosahedronGeometry(1.8,0), matSolid, -7,4,-3.1); ico1s._spin=ico1._spin; objects.push(ico1s);
  const octa   = addObj(new THREE.OctahedronGeometry(1.4,0), matWire, 8,4,-2); octa._spin={x:.007,y:-.006,z:.004}; objects.push(octa);
  const tetra  = addObj(new THREE.TetrahedronGeometry(1.3,0), matWire, -6,-4.5,-2); tetra._spin={x:.008,y:.004,z:-.005}; objects.push(tetra);
  const dotGeo = new THREE.SphereGeometry(.07,6,6);
  const dotCount = window.innerWidth < 1200 ? 16 : 24;
  for (let i = 0; i < dotCount; i++) {
    const dot = addObj(dotGeo, matDot, (Math.random()-.5)*28, (Math.random()-.5)*20, (Math.random()-.5)*6-3);
    dot._float = { baseY:dot.position.y, speed:.3+Math.random()*.5, phase:Math.random()*Math.PI*2, amp:.4+Math.random()*.8 };
    objects.push(dot);
  }
  let mouseX=0,mouseY=0,targetMX=0,targetMY=0;
  section.addEventListener('mousemove', e => {
    const r = section.getBoundingClientRect();
    targetMX=((e.clientX-r.left)/r.width-.5)*2;
    targetMY=((e.clientY-r.top)/r.height-.5)*2;
  });
  let t = 0;
  let lastFrame = 0;
  function animate(now) {
    requestAnimationFrame(animate);
    if (document.hidden || !heroVisible) return;
    if (now - lastFrame < 33) return; // cap sekitar 30 FPS agar tidak berat
    lastFrame = now;
    t += .033;
    mouseX += (targetMX-mouseX)*.06; mouseY += (targetMY-mouseY)*.06;
    camera.position.x = mouseX*2.2; camera.position.y = -mouseY*1.25;
    camera.lookAt(0,0,0);
    objects.forEach(obj => {
      if(obj._spin){obj.rotation.x+=obj._spin.x;obj.rotation.y+=obj._spin.y;obj.rotation.z+=obj._spin.z;}
      if(obj._float) obj.position.y = obj._float.baseY + Math.sin(t*obj._float.speed+obj._float.phase)*obj._float.amp;
    });
    ico1s.rotation.copy(ico1.rotation);
    renderer.render(scene, camera);
  }
  requestAnimationFrame(animate);
}
(function scheduleHeroThree() {
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const smallScreen = window.matchMedia('(max-width: 768px)').matches;
  if (reduceMotion || smallScreen) {
    const canvas = document.getElementById('hero-canvas');
    if (canvas) canvas.remove();
    return;
  }
  const loadThree = () => {
    if (window.THREE) { initHeroThree(); return; }
    const script = document.createElement('script');
    script.src = 'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js';
    script.async = true;
    script.onload = initHeroThree;
    document.head.appendChild(script);
  };
  if ('requestIdleCallback' in window) requestIdleCallback(loadThree, { timeout: 1500 });
  else window.setTimeout(loadThree, 250);
})();
</script>
