/* ══════════════════════════════════════════════
   AL MUTHI CREATIVE — DESIGN SYSTEM
   Sky blue gradient + white premium aesthetic
══════════════════════════════════════════════ */

:root {
  --sky-200: #bae6fd;
  --sky-300: #7dd3fc;
  --sky-400: #38bdf8;
  --sky-500: #0ea5e9;
  --sky-600: #0284c7;
  --sky-700: #0369a1;
  --slate-50: #f8fafc;
  --slate-100: #f0f9ff;
  --slate-200: #e0f2fe;
  --slate-400: #94a3b8;
  --slate-500: #64748b;
  --slate-600: #475569;
  --slate-700: #334155;
  --slate-800: #1e293b;
  --slate-900: #0f172a;
  --nav-h: 72px;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

body {
  font-family: 'Plus Jakarta Sans', sans-serif;
  background: var(--slate-50);
  color: var(--slate-900);
  overflow-x: hidden;
  cursor: none;
}

/* ── SCROLL PROGRESS ── */
#scroll-progress {
  position: fixed; top: 0; left: 0; height: 3px; z-index: 9999;
  background: linear-gradient(90deg, #0ea5e9, #38bdf8, #0284c7);
  width: 0%; transition: width .1s linear;
  box-shadow: 0 0 8px rgba(14,165,233,0.6);
  pointer-events: none;
}

/* ── CUSTOM CURSOR ── */
#cursor-dot, #cursor-ring {
  position: fixed; top: 0; left: 0;
  border-radius: 50%; pointer-events: none;
  z-index: 9999; will-change: transform;
}
#cursor-dot {
  width: 7px; height: 7px; background: #0284c7;
  margin-left: -3.5px; margin-top: -3.5px;
  transition: transform .15s ease;
}
#cursor-ring {
  width: 36px; height: 36px;
  border: 1.5px solid rgba(14,165,233,0.5);
  margin-left: -18px; margin-top: -18px;
  transition: width .3s cubic-bezier(.16,1,.3,1), height .3s, background-color .25s, border-color .25s, margin .3s cubic-bezier(.16,1,.3,1);
}
body.hovering #cursor-ring {
  width: 52px; height: 52px;
  margin-left: -26px; margin-top: -26px;
  background: rgba(14,165,233,0.08);
  border-color: rgba(14,165,233,0.25);
}
body.hovering #cursor-dot { transform: scale(0.5); }
@media (hover: none) { #cursor-dot, #cursor-ring { display: none; } body { cursor: auto; } }

/* ── GLASS NAV ── */
.glass-nav {
  background: rgba(255,255,255,0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(255,255,255,0.95);
}

/* ── TEXT GRADIENT ── */
.text-gradient {
  background: linear-gradient(135deg, #0284c7 0%, #38bdf8 55%, #0369a1 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* ── SECTION PILL / LABEL ── */
.section-label {
  display: inline-flex; align-items: center; gap: .5rem;
  padding: .3rem .9rem; border-radius: 9999px;
  background: rgba(14,165,233,0.08);
  border: 1px solid rgba(14,165,233,0.2);
  color: #0284c7;
  font-size: .7rem; font-weight: 800;
  letter-spacing: .12em; text-transform: uppercase;
}

/* ── BUTTONS ── */
.btn-primary {
  position: relative; overflow: hidden;
  background: linear-gradient(160deg, #7dd3fc 0%, #38bdf8 40%, #0ea5e9 100%);
  color: white; border-radius: 9999px;
  padding: .875rem 2rem; font-weight: 800; font-size: .95rem;
  transition: all .3s ease; display: inline-flex; align-items: center; gap: .5rem;
  box-shadow: 0 6px 28px -4px rgba(56,189,248,0.55), inset 0 1.5px 0 rgba(255,255,255,0.45);
  border: 1.5px solid rgba(255,255,255,0.35);
  text-decoration: none; cursor: pointer;
}
.btn-primary::before {
  content: ''; position: absolute; inset: 0; border-radius: 9999px;
  background: linear-gradient(180deg, rgba(255,255,255,0.3) 0%, transparent 55%);
  pointer-events: none;
}
.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 14px 36px -6px rgba(14,165,233,0.55), inset 0 1.5px 0 rgba(255,255,255,0.5);
  filter: brightness(1.06);
}
.btn-secondary {
  background: rgba(255,255,255,0.9); backdrop-filter: blur(16px);
  color: #0284c7; border: 1.5px solid rgba(56,189,248,0.4);
  border-radius: 9999px; padding: .875rem 2rem; font-weight: 700; font-size: .95rem;
  transition: all .3s ease; display: inline-flex; align-items: center; gap: .5rem;
  box-shadow: 0 2px 12px rgba(14,165,233,0.08); text-decoration: none; cursor: pointer;
}
.btn-secondary:hover {
  border-color: #0ea5e9; transform: translateY(-2px);
  box-shadow: 0 10px 28px -6px rgba(14,165,233,0.22);
  background: white;
}
.btn-glow {
  animation: glowPulse 2.5s ease-in-out infinite;
}
@keyframes glowPulse {
  0%,100% { box-shadow: 0 6px 28px -4px rgba(56,189,248,0.55), inset 0 1.5px 0 rgba(255,255,255,0.45), 0 0 0 0 rgba(125,211,252,0.3); }
  50% { box-shadow: 0 10px 36px -4px rgba(14,165,233,0.5), inset 0 1.5px 0 rgba(255,255,255,0.5), 0 0 0 10px rgba(125,211,252,0); }
}

/* ── GLASS CARD ── */
.glass-card {
  background: rgba(255,255,255,0.75);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1.5px solid rgba(255,255,255,0.8);
  box-shadow: 0 4px 24px rgba(0,0,0,0.05);
}

/* ── NAVBAR ── */
.site-nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
  height: var(--nav-h);
}
.nav-inner {
  max-width: 1280px; margin: 0 auto; padding: 0 1.5rem;
  height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 2rem;
}
.nav-logo {
  display: flex; align-items: center; gap: .75rem;
  text-decoration: none; flex-shrink: 0;
}
.nav-logo-img {
  width: 36px; height: 36px; border-radius: 10px;
  overflow: hidden; box-shadow: 0 2px 8px rgba(14,165,233,0.25);
  background: #f0f9ff; display: flex; align-items: center; justify-content: center;
}
.nav-logo-img img { width: 100%; height: 100%; object-fit: contain; }
.nav-logo-text {
  font-weight: 900; font-size: 1rem; color: var(--slate-900);
  letter-spacing: -.01em;
}
.nav-logo-text span { color: var(--sky-600); }
.nav-links {
  display: flex; align-items: center; gap: 1.75rem;
  list-style: none;
}
.nav-links a {
  color: var(--slate-500); font-size: .875rem; font-weight: 600;
  text-decoration: none; transition: color .2s;
  position: relative;
}
.nav-links a:hover { color: var(--sky-600); }
/* Dropdown */
.nav-dropdown { position: relative; }
.nav-dropdown-btn {
  display: flex; align-items: center; gap: .3rem;
  color: var(--slate-500); font-size: .875rem; font-weight: 600;
  background: none; border: none; cursor: pointer; padding: 0;
  transition: color .2s;
}
.nav-dropdown-btn:hover, .nav-dropdown:hover .nav-dropdown-btn { color: var(--sky-600); }
.nav-dropdown-menu {
  position: absolute; top: calc(100% + 1rem); left: 50%; transform: translateX(-50%);
  background: white; border: 1px solid rgba(186,230,253,0.6);
  border-radius: 1.25rem; min-width: 180px;
  box-shadow: 0 20px 48px -12px rgba(2,132,199,0.2);
  padding: .5rem; opacity: 0; pointer-events: none;
  transform: translateX(-50%) translateY(-8px);
  transition: opacity .25s ease, transform .25s ease;
}
.nav-dropdown:hover .nav-dropdown-menu,
.nav-dropdown:focus-within .nav-dropdown-menu {
  opacity: 1; pointer-events: auto;
  transform: translateX(-50%) translateY(0);
}
.nav-dropdown-menu a {
  display: flex; align-items: center; gap: .625rem;
  padding: .65rem 1rem; border-radius: .875rem;
  color: var(--slate-600); font-size: .875rem; font-weight: 600;
  text-decoration: none; transition: all .15s;
}
.nav-dropdown-menu a:hover { background: #f0f9ff; color: var(--sky-600); }
.nav-dropdown-menu a svg { width: 15px; height: 15px; flex-shrink: 0; }
.nav-cta {
  text-decoration: none; flex-shrink: 0;
}
.nav-hamburger {
  display: none; flex-direction: column; justify-content: center;
  gap: 5px; width: 36px; height: 36px; border-radius: 10px;
  background: #f1f5f9; border: none; cursor: pointer; padding: 8px;
}
.ham-bar {
  width: 100%; height: 2px; background: var(--slate-600);
  border-radius: 2px; transition: all .3s ease; display: block;
}
.nav-hamburger.open .ham-bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.nav-hamburger.open .ham-bar:nth-child(2) { opacity: 0; transform: scaleX(0); }
.nav-hamburger.open .ham-bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

/* Mobile menu */
.mobile-menu {
  position: absolute; top: calc(100% + .5rem); left: 1rem; right: 1rem;
  background: rgba(255,255,255,0.97); backdrop-filter: blur(20px);
  border: 1px solid rgba(186,230,253,0.6); border-radius: 1.5rem;
  box-shadow: 0 20px 48px -12px rgba(2,132,199,0.2);
  padding: 1rem; display: none; flex-direction: column; gap: .25rem;
}
.mobile-menu.open { display: flex; }
.mobile-menu a, .mobile-menu-sub a {
  display: flex; align-items: center; gap: .625rem;
  padding: .75rem 1rem; border-radius: 1rem;
  color: var(--slate-600); font-size: .9rem; font-weight: 600;
  text-decoration: none; transition: all .15s;
}
.mobile-menu a:hover, .mobile-menu-sub a:hover { background: #f0f9ff; color: var(--sky-600); }
.mobile-menu-label {
  padding: .5rem 1rem .25rem;
  font-size: .7rem; font-weight: 800; color: var(--slate-400);
  letter-spacing: .1em; text-transform: uppercase;
}
.mobile-menu-sub { padding-left: .75rem; }
.mobile-menu-sub a { padding: .5rem 1rem; font-size: .85rem; }
.mobile-cta-wrap { padding-top: .5rem; }

@media (max-width: 900px) {
  .nav-links, .nav-cta { display: none !important; }
  .nav-hamburger { display: flex; }
}

/* ── HERO ANIMATIONS ── */
@keyframes floatY { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-12px)} }
@keyframes floatY2 { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-9px)} }
@keyframes floatY3 { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-14px)} }
@keyframes orbFloat {
  0%,100%{transform:translate(0,0) scale(1)}
  33%{transform:translate(30px,-20px) scale(1.05)}
  66%{transform:translate(-20px,15px) scale(0.95)}
}
@keyframes orbFloat2 {
  0%,100%{transform:translate(0,0) scale(1)}
  33%{transform:translate(-25px,20px) scale(1.03)}
  66%{transform:translate(20px,-15px) scale(0.97)}
}
@keyframes gridShift {
  0%{background-position:0 0} 100%{background-position:40px 40px}
}
@keyframes pulseRing {
  0%{transform:scale(.88);opacity:1} 100%{transform:scale(1.7);opacity:0}
}
@keyframes scrollBounce {
  0%,100%{transform:translateY(0);opacity:.5} 50%{transform:translateY(9px);opacity:.2}
}
@keyframes marqueeLeft { from{transform:translateX(0)} to{transform:translateX(-50%)} }
@keyframes marqueeRight { from{transform:translateX(-50%)} to{transform:translateX(0)} }
@keyframes dotFloat {
  0%,100%{opacity:.3;transform:translateY(0) scale(1)} 50%{opacity:.8;transform:translateY(-12px) scale(1.2)}
}
@keyframes staggerIn {
  from{opacity:0;transform:translateY(24px)} to{opacity:1;transform:translateY(0)}
}
@keyframes shine {
  0%{transform:translateX(-100%) rotate(25deg)} 100%{transform:translateX(400%) rotate(25deg)}
}

.float-y-1 { animation: floatY 4s ease-in-out infinite; }
.float-y-2 { animation: floatY2 5.2s ease-in-out infinite .9s; }
.float-y-3 { animation: floatY3 3.8s ease-in-out infinite 1.6s; }
.float-y-4 { animation: floatY 4.5s ease-in-out infinite .4s; }
.orb-1 { animation: orbFloat 12s ease-in-out infinite; }
.orb-2 { animation: orbFloat2 15s ease-in-out infinite 2s; }
.orb-3 { animation: orbFloat 18s ease-in-out infinite 4s; }
.pulse-ring { animation: pulseRing 2s cubic-bezier(.455,.03,.515,.955) infinite; }
.scroll-indicator { animation: scrollBounce 2.2s ease-in-out infinite; }
.animate-marquee-l { animation: marqueeLeft 40s linear infinite; }
.animate-marquee-r { animation: marqueeRight 45s linear infinite; }
.section-dot { animation: dotFloat var(--dur,4s) ease-in-out infinite var(--delay,0s); }
.shine-wrap { position: relative; overflow: hidden; }
.shine-wrap::before {
  content:''; position:absolute; top:-50%; left:-50%; width:40%; height:200%;
  background:linear-gradient(to right,transparent,rgba(255,255,255,.15),transparent);
  transform:translateX(-100%) rotate(25deg); pointer-events:none;
}
.shine-wrap:hover::before { animation: shine .7s ease forwards; }

/* ── MARQUEE ── */
.marquee-container {
  position: relative; overflow: hidden; padding: 1.25rem 0;
  mask-image: linear-gradient(to right,transparent,black 6%,black 94%,transparent);
}
.marquee-content { display: flex; gap: 1rem; width: max-content; }

/* ── GRID BACKGROUND ── */
.animated-grid {
  background-image: linear-gradient(rgba(2,132,199,0.04) 1px,transparent 1px),
                    linear-gradient(90deg,rgba(2,132,199,0.04) 1px,transparent 1px);
  background-size: 40px 40px;
  animation: gridShift 8s linear infinite;
}

/* ── WA FLOAT ── */
.wa-float {
  position: fixed; bottom: 1.5rem; right: 1.5rem; z-index: 100;
  background: linear-gradient(160deg,#7dd3fc 0%,#38bdf8 40%,#0ea5e9 100%);
  color: white; border-radius: 9999px;
  padding: .75rem 1.25rem; display: flex; align-items: center; gap: .5rem;
  font-weight: 700; font-size: .85rem;
  box-shadow: 0 6px 24px -4px rgba(56,189,248,0.5), inset 0 1.5px 0 rgba(255,255,255,0.4);
  border: 1.5px solid rgba(255,255,255,0.35);
  transition: all .3s ease; text-decoration: none;
}
.wa-float:hover { transform: translateY(-3px); box-shadow: 0 14px 32px -6px rgba(2,132,199,0.5); }
@supports (padding-bottom: env(safe-area-inset-bottom)) {
  .wa-float { bottom: calc(1.25rem + env(safe-area-inset-bottom)); }
}

/* ── FOOTER ── */
.site-footer {
  background: linear-gradient(180deg,#f0f9ff 0%,#e0f2fe 40%,#f8fafc 100%);
  border-top: 1px solid #e0f2fe;
  padding: 4rem 0 2rem;
}
.footer-inner {
  max-width: 1280px; margin: 0 auto; padding: 0 1.5rem;
}
.footer-grid {
  display: grid; grid-template-columns: 2fr 1fr 1fr;
  gap: 3rem; margin-bottom: 3rem;
}
@media (max-width: 768px) {
  .footer-grid { grid-template-columns: 1fr 1fr; gap: 2rem; }
}
@media (max-width: 480px) {
  .footer-grid { grid-template-columns: 1fr; gap: 1.5rem; }
}
.footer-logo {
  display: flex; align-items: center; gap: .75rem;
  text-decoration: none; margin-bottom: 1rem;
}
.footer-logo-img {
  width: 40px; height: 40px; border-radius: 12px;
  overflow: hidden; box-shadow: 0 2px 8px rgba(14,165,233,0.2); flex-shrink: 0;
  background: #f0f9ff;
}
.footer-logo-img img { width: 100%; height: 100%; object-fit: contain; }
.footer-logo-text {
  font-weight: 900; font-size: 1.1rem; color: var(--slate-900);
}
.footer-logo-text span { color: var(--sky-600); }
.footer-desc {
  color: var(--slate-500); font-size: .875rem; line-height: 1.7; margin-bottom: 1rem;
}
.footer-status {
  display: inline-flex; align-items: center; gap: .5rem;
  font-size: .75rem; font-weight: 600; color: #059669;
}
.footer-status::before {
  content:''; width: 7px; height: 7px; border-radius: 50%; background: #10b981; flex-shrink: 0;
}
.footer-nav-title {
  font-size: .75rem; font-weight: 800; color: var(--slate-900);
  text-transform: uppercase; letter-spacing: .1em; margin-bottom: 1rem;
}
.footer-nav-list { list-style: none; display: flex; flex-direction: column; gap: .5rem; }
.footer-nav-list a {
  color: var(--slate-500); font-size: .875rem; font-weight: 500;
  text-decoration: none; transition: color .2s;
}
.footer-nav-list a:hover { color: var(--sky-600); }
.footer-contact-item {
  display: flex; align-items: center; gap: .625rem; margin-bottom: .625rem;
}
.footer-contact-item a {
  color: var(--slate-500); font-size: .875rem; text-decoration: none; transition: color .2s;
}
.footer-contact-item a:hover { color: var(--sky-600); }
.footer-socials {
  display: flex; gap: .625rem; margin-top: 1rem;
}
.footer-social-btn {
  width: 38px; height: 38px; border-radius: 10px; background: white;
  border: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: center;
  transition: all .3s; overflow: hidden; text-decoration: none;
}
.footer-social-btn:hover { border-color: var(--sky-400); box-shadow: 0 4px 16px rgba(14,165,233,0.2); transform: translateY(-2px); }
.footer-social-btn img { width: 22px; height: 22px; object-fit: contain; }
.footer-bottom {
  border-top: 1px solid #e0f2fe; padding-top: 1.5rem;
  display: flex; justify-content: space-between; align-items: center; gap: 1rem;
  flex-wrap: wrap;
}
.footer-copy {
  color: var(--slate-400); font-size: .8rem;
}

/* ── PAGE HERO ── */
.page-hero {
  padding: calc(var(--nav-h) + 4rem) 1.5rem 5rem;
  text-align: center; position: relative; overflow: hidden;
  background: linear-gradient(180deg,#ffffff 0%,#f0f9ff 60%,#e0f2fe 100%);
}
.page-hero::before {
  content:''; position:absolute; inset:0;
  background: radial-gradient(ellipse 80% 60% at 20% 30%,rgba(186,230,253,0.7) 0%,transparent 55%),
              radial-gradient(ellipse 60% 50% at 80% 70%,rgba(125,211,252,0.4) 0%,transparent 50%);
  pointer-events: none;
}
.page-hero-inner { position: relative; z-index: 1; max-width: 720px; margin: 0 auto; }
.page-hero-label { margin-bottom: 1.25rem; }
.page-hero h1 {
  font-size: clamp(2.25rem,5vw,3.75rem);
  font-weight: 900; letter-spacing: -.03em; line-height: 1.1;
  color: var(--slate-900); margin-bottom: 1.25rem;
}
.page-hero p {
  font-size: 1.1rem; color: var(--slate-500); line-height: 1.7; font-weight: 500;
}

/* ── CONTENT SECTION ── */
.content-section {
  padding: 5rem 1.5rem; max-width: 1280px; margin: 0 auto;
}

/* ── CARD ── */
.amc-card {
  background: white; border: 1.5px solid #e2e8f0;
  border-radius: 1.5rem; padding: 2rem;
  box-shadow: 0 2px 12px rgba(0,0,0,0.04);
  transition: all .3s ease;
}
.amc-card:hover {
  border-color: var(--sky-300);
  box-shadow: 0 16px 40px -8px rgba(2,132,199,0.15);
  transform: translateY(-4px);
}

/* ── ACCORDION (FAQ) ── */
.accordion-item {
  background: white; border: 1.5px solid #e2e8f0;
  border-radius: 1.25rem; overflow: hidden;
  transition: all .3s ease; margin-bottom: .75rem;
}
.accordion-item.open { border-color: var(--sky-300); box-shadow: 0 8px 24px -6px rgba(2,132,199,0.12); }
.accordion-header {
  display: flex; align-items: center; justify-content: space-between; gap: 1rem;
  padding: 1.25rem 1.5rem; cursor: pointer; user-select: none;
  background: none; border: none; width: 100%; text-align: left;
}
.accordion-header h3 { font-size: 1rem; font-weight: 700; color: var(--slate-800); }
.accordion-icon {
  width: 28px; height: 28px; border-radius: 8px; flex-shrink: 0;
  background: #f0f9ff; border: 1px solid #bae6fd;
  display: flex; align-items: center; justify-content: center;
  transition: all .3s ease;
}
.accordion-item.open .accordion-icon { background: var(--sky-500); border-color: var(--sky-500); transform: rotate(45deg); }
.accordion-icon svg { width: 14px; height: 14px; }
.accordion-item.open .accordion-icon svg { color: white; }
.accordion-body {
  max-height: 0; overflow: hidden; transition: max-height .4s cubic-bezier(.4,0,.2,1);
  padding: 0 1.5rem;
}
.accordion-item.open .accordion-body { max-height: 300px; }
.accordion-body-inner { padding-bottom: 1.25rem; }
.accordion-body p { color: var(--slate-500); font-size: .95rem; line-height: 1.75; }

/* ── CONTACT CARD ── */
.contact-card {
  background: white; border: 1.5px solid #e2e8f0;
  border-radius: 1.5rem; padding: 1.75rem;
  transition: all .3s; display: flex; align-items: center; gap: 1.25rem;
  text-decoration: none;
}
.contact-card:hover {
  border-color: var(--sky-300);
  box-shadow: 0 16px 40px -8px rgba(2,132,199,0.15);
  transform: translateY(-4px);
}
.contact-card-icon {
  width: 56px; height: 56px; border-radius: 16px; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 1.5rem;
}
.contact-card-text h3 { font-size: 1rem; font-weight: 800; color: var(--slate-900); margin-bottom: .25rem; }
.contact-card-text p { font-size: .875rem; font-weight: 600; color: var(--sky-600); }

/* ── FORM ── */
.form-panel {
  background: rgba(255,255,255,0.95); backdrop-filter: blur(20px);
  border: 1.5px solid rgba(186,230,253,0.6); border-radius: 2rem;
  padding: 2.5rem;
  box-shadow: 0 16px 48px -20px rgba(2,132,199,0.25);
}
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
@media (max-width: 600px) { .form-grid { grid-template-columns: 1fr; } }
.form-field { display: flex; flex-direction: column; gap: .5rem; }
.form-field.col-2 { grid-column: span 2; }
@media (max-width: 600px) { .form-field.col-2 { grid-column: span 1; } }
.form-label {
  font-size: .8rem; font-weight: 800; color: var(--slate-700);
  display: flex; align-items: center; gap: .4rem;
}
.form-control {
  width: 100%; padding: .875rem 1.125rem; border-radius: 1rem;
  border: 1.5px solid #e2e8f0; background: #f8fafc;
  font-family: inherit; font-size: .95rem; color: var(--slate-900);
  outline: none; transition: border-color .2s, box-shadow .2s, background .2s;
}
.form-control::placeholder { color: var(--slate-400); }
.form-control:focus { border-color: var(--sky-400); background: white; box-shadow: 0 0 0 3px rgba(56,189,248,0.12); }
textarea.form-control { resize: vertical; min-height: 100px; }

/* ── BLOG CARD (layanan pages) ── */
.service-grid {
  display: grid; grid-template-columns: repeat(auto-fill,minmax(280px,1fr)); gap: 1.25rem;
}
@media (max-width: 640px) { .service-grid { grid-template-columns: 1fr; } }
.service-card {
  background: white; border: 1.5px solid #e2e8f0; border-radius: 1.75rem;
  overflow: hidden; transition: all .3s ease; position: relative;
  display: flex; flex-direction: column;
}
.service-card:hover {
  border-color: var(--sky-300);
  box-shadow: 0 20px 48px -12px rgba(2,132,199,0.18);
  transform: translateY(-6px);
}
.service-card-header {
  padding: 1.75rem 1.75rem 1.25rem;
  background: linear-gradient(135deg,#f0f9ff,#e0f2fe);
  border-bottom: 1px solid #e0f2fe;
  display: flex; align-items: center; gap: 1rem;
}
.service-card-icon {
  width: 52px; height: 52px; border-radius: 14px; background: white;
  display: flex; align-items: center; justify-content: center; font-size: 1.5rem;
  box-shadow: 0 4px 12px rgba(2,132,199,0.12); flex-shrink: 0;
  border: 1px solid rgba(186,230,253,0.6);
}
.service-card-badge {
  display: inline-block; padding: .2rem .65rem; border-radius: 9999px;
  font-size: .65rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase;
}
.service-card-body { padding: 1.25rem 1.75rem 1.75rem; flex: 1; display: flex; flex-direction: column; gap: .75rem; }
.service-card-title { font-size: 1.1rem; font-weight: 800; color: var(--slate-900); }
.service-card-desc { font-size: .875rem; color: var(--slate-500); line-height: 1.6; flex: 1; }
.service-card-actions { display: flex; gap: .75rem; flex-wrap: wrap; }
.service-card-btn {
  display: inline-flex; align-items: center; gap: .4rem;
  padding: .65rem 1.25rem; border-radius: 9999px; font-size: .8rem; font-weight: 700;
  text-decoration: none; transition: all .25s; white-space: nowrap;
}
.service-card-btn-primary {
  background: linear-gradient(135deg,#38bdf8,#0ea5e9); color: white;
  box-shadow: 0 4px 12px rgba(14,165,233,0.35);
}
.service-card-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(14,165,233,0.45); filter: brightness(1.05); }
.service-card-btn-secondary {
  background: #f0f9ff; color: var(--sky-600);
  border: 1px solid rgba(56,189,248,0.3);
}
.service-card-btn-secondary:hover { background: #e0f2fe; border-color: var(--sky-400); }

/* ── FEATURED CARD ── */
.featured-card {
  background: linear-gradient(135deg,#0ea5e9 0%,#0284c7 60%,#0369a1 100%);
  border-radius: 2rem; padding: 3rem; margin-bottom: 3rem; position: relative; overflow: hidden;
  box-shadow: 0 24px 64px -16px rgba(2,132,199,0.5);
}
.featured-card::before {
  content:''; position:absolute; inset:0;
  background-image: linear-gradient(rgba(255,255,255,0.05) 1px,transparent 1px),
                    linear-gradient(90deg,rgba(255,255,255,0.05) 1px,transparent 1px);
  background-size: 36px 36px;
}
.featured-card-inner { position: relative; z-index: 1; }
.featured-card h2 { font-size: clamp(1.5rem,3vw,2.25rem); font-weight: 900; color: white; margin-bottom: 1rem; }
.featured-card p { color: rgba(255,255,255,0.8); font-size: 1.05rem; line-height: 1.7; max-width: 56ch; }

/* ── TERMS ── */
.terms-section { margin-bottom: 2.5rem; }
.terms-section h2 {
  font-size: 1.25rem; font-weight: 800; color: var(--slate-900);
  margin-bottom: 1rem; padding-bottom: .75rem;
  border-bottom: 2px solid #e0f2fe;
}
.terms-section p, .terms-section li {
  color: var(--slate-500); font-size: .975rem; line-height: 1.8;
}
.terms-section ul { padding-left: 1.5rem; margin-top: .5rem; display: flex; flex-direction: column; gap: .375rem; }

/* ── STEP CARD (bot order) ── */
.step-card {
  background: white; border: 1.5px solid #e2e8f0; border-radius: 1.75rem;
  padding: 2rem; transition: all .3s; position: relative; overflow: hidden;
}
.step-card::before {
  content:''; position:absolute; top:0; left:0; right:0; height:3px;
  background: linear-gradient(90deg,#38bdf8,#0ea5e9);
}
.step-card:hover {
  border-color: var(--sky-300);
  box-shadow: 0 20px 48px -12px rgba(2,132,199,0.18);
  transform: translateY(-6px);
}
.step-number {
  width: 36px; height: 36px; border-radius: 10px;
  background: linear-gradient(135deg,#38bdf8,#0ea5e9);
  color: white; font-weight: 900; font-size: .9rem;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 1.25rem; flex-shrink: 0;
}
.step-icon {
  width: 52px; height: 52px; border-radius: 14px;
  background: #f0f9ff; border: 1px solid #bae6fd;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 1.25rem; font-size: 1.5rem;
}

/* ── RESPONSIVE CONTAINER ── */
.container { max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; }

/* ── AOS OVERRIDE ── */
[data-aos] { pointer-events: none; }
[data-aos].aos-animate { pointer-events: auto; }

/* ── PAGE TRANSITION ── */
.page-wrapper {
  animation: pageIn .4s cubic-bezier(.4,0,.2,1) both;
}
@keyframes pageIn {
  from { opacity: 0; transform: translateY(12px); }
  to { opacity: 1; transform: translateY(0); }
}

/* ── HIGHLIGHTS (bot section) ── */
.highlight-badge {
  display: inline-flex; align-items: center; gap: .5rem;
  padding: .4rem .875rem; border-radius: 9999px;
  background: white; border: 1.5px solid #bae6fd;
  font-size: .8rem; font-weight: 700; color: var(--sky-700);
  box-shadow: 0 2px 8px rgba(2,132,199,0.08);
}
.highlight-badge::before {
  content:''; width:6px; height:6px; border-radius:50%; background:#38bdf8; flex-shrink:0;
}
