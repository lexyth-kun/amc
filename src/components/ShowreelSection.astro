---
import content from '@/data/content.json';
import products from '@/data/products.json';
import ActionIcon from './ActionIcon.astro';
---

<section
  id="reel"
  data-bg-color="#F0F9FF"
  class="bg-bg-alt pb-16 md:pb-28"
  aria-labelledby="reel-heading"
>
  <div class="mx-auto max-w-amc px-4 sm:px-6">
    <!-- Showreel Stage -->
    <div
      data-fade-up
      class="group relative overflow-hidden rounded-card border border-line bg-gradient-to-br from-bg-deep via-white to-bg-alt p-6 shadow-amc sm:p-10 md:p-16"
    >
      <div
        class="pointer-events-none absolute inset-0 transition-transform duration-500 ease-out group-hover:scale-[1.03]"
        aria-hidden="true"
      >
        <div
          class="absolute -left-20 -top-20 h-80 w-80 rounded-full bg-[radial-gradient(circle,rgba(56,189,248,0.28)_0%,rgba(56,189,248,0)_70%)]"
        ></div>
        <div
          class="absolute -bottom-24 -right-16 h-96 w-96 rounded-full bg-[radial-gradient(circle,rgba(2,132,199,0.18)_0%,rgba(2,132,199,0)_72%)]"
        ></div>

        <svg
          class="absolute -right-4 -top-4 h-24 w-24 opacity-50 sm:right-8 sm:top-8 sm:h-32 sm:w-32"
          viewBox="0 0 120 120"
          fill="#BAE6FD"
        >
          <rect x="44" y="12" width="32" height="96" rx="12"></rect>
          <rect x="12" y="44" width="96" height="32" rx="12"></rect>
        </svg>

        <svg
          class="absolute -bottom-4 -left-4 h-20 w-20 rotate-12 opacity-60 sm:bottom-8 sm:left-10 sm:h-24 sm:w-24"
          viewBox="0 0 120 120"
          fill="#E0F2FE"
        >
          <rect x="44" y="12" width="32" height="96" rx="12"></rect>
          <rect x="12" y="44" width="96" height="32" rx="12"></rect>
        </svg>
      </div>

      <div class="relative z-10 flex min-h-[300px] flex-col items-center justify-center text-center sm:min-h-[380px]">
        <p class="eyebrow-label mb-3">{content.showreel.eyebrow}</p>
        <h2
          id="reel-heading"
          class="max-w-xl font-display text-2xl font-extrabold tracking-[-0.03em] text-navy sm:text-4xl"
        >
          {content.showreel.title}
        </h2>

        <button
          type="button"
          id="open-reel-btn"
          aria-haspopup="dialog"
          aria-controls="showreel-modal"
          class="mt-8 inline-flex h-24 w-24 flex-col items-center justify-center gap-1 rounded-full border border-line bg-white font-display text-xs font-extrabold tracking-[0.16em] text-navy shadow-[0_20px_50px_rgba(2,132,199,0.2)] transition-transform duration-300 group-hover:scale-110 hover:!scale-110 sm:h-28 sm:w-28"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="ml-0.5 text-sky-ink" aria-hidden="true">
            <path d="M8 5v14l11-7z"></path>
          </svg>
          <span>{content.showreel.playButtonLabel}</span>
        </button>

        <p class="mt-6 max-w-md text-sm leading-relaxed text-body">
          {content.showreel.caption}
        </p>
      </div>
    </div>

    <!-- Constant Product Ticker -->
    <div class="mt-6 flex items-center gap-3 rounded-2xl border border-line bg-white px-4 py-3">
      <div id="reel-text-marquee" class="marquee-wrap flex-1 overflow-hidden">
        <div class="marquee-track items-center gap-6">
          {
            [
              ...products.reelTickerItems,
              ...products.reelTickerItems,
              ...products.reelTickerItems,
              ...products.reelTickerItems,
            ].map((word, idx) => (
              <span
                class="inline-flex shrink-0 items-center gap-6 font-display text-sm font-extrabold tracking-[0.2em] text-sky-ink sm:text-base"
                aria-hidden={idx >= products.reelTickerItems.length ? 'true' : undefined}
              >
                <span>{word}</span>
                <span class="h-1.5 w-1.5 rounded-full bg-sky" aria-hidden="true"></span>
              </span>
            ))
          }
        </div>
      </div>

      <button
        type="button"
        data-marquee-toggle="reel-text-marquee"
        aria-label="Jeda animasi teks produk"
        aria-pressed="false"
        class="inline-flex min-h-[44px] min-w-[44px] shrink-0 items-center justify-center rounded-xl border border-line bg-bg-alt text-navy transition-colors hover:border-amc hover:text-amc"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <rect x="6" y="5" width="4" height="14" rx="1"></rect>
          <rect x="14" y="5" width="4" height="14" rx="1"></rect>
        </svg>
      </button>
    </div>
  </div>

  <!-- Interactive 4-Step Showreel Modal -->
  <div
    id="showreel-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="showreel-modal-title"
    hidden
    class="fixed inset-0 z-[9992] flex items-center justify-center bg-[#082F49]/70 p-4"
  >
    <div class="relative w-full max-w-2xl rounded-card border border-line bg-white p-6 shadow-2xl sm:p-8">
      <div class="flex items-center justify-between gap-4 border-b border-line pb-4">
        <div>
          <p class="eyebrow-label">REEL CARA ORDER</p>
          <h3 id="showreel-modal-title" class="mt-1 font-display text-xl font-extrabold text-navy">
            4 Langkah Langsung Aktif
          </h3>
        </div>

        <div class="flex items-center gap-2">
          <button
            type="button"
            id="reel-pause-btn"
            aria-label="Jeda pemutaran langkah otomatis"
            aria-pressed="false"
            class="inline-flex min-h-[44px] items-center gap-1.5 rounded-full border border-line bg-bg-alt px-3.5 py-2 font-display text-xs font-bold text-navy hover:border-amc hover:text-amc"
          >
            <span id="reel-pause-label">Jeda</span>
          </button>

          <button
            type="button"
            id="close-reel-btn"
            aria-label="Tutup panduan cara order"
            class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full border border-line bg-bg-alt text-navy hover:border-amc hover:text-amc"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
              <path d="M18 6L6 18M6 6l12 12"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Step Tabs -->
      <div class="mt-5 grid grid-cols-4 gap-2" role="tablist" aria-label="Langkah pemesanan">
        {
          content.showreel.steps.map((s, idx) => (
            <button
              type="button"
              role="tab"
              data-reel-tab={idx}
              aria-selected={idx === 0 ? 'true' : 'false'}
              class={`min-h-[44px] rounded-xl border px-2 py-2 font-display text-xs font-extrabold transition-colors ${
                idx === 0
                  ? 'border-amc-2 bg-amc-2 text-white'
                  : 'border-line bg-bg-alt text-navy hover:border-sky-deep'
              }`}
            >
              Langkah {s.step}
            </button>
          ))
        }
      </div>

      <!-- Active Slide Stage -->
      <div class="mt-5 min-h-[170px] rounded-2xl border border-line bg-bg-alt p-6">
        {
          content.showreel.steps.map((s, idx) => (
            <div data-reel-slide={idx} hidden={idx !== 0}>
              <span class="tabular-nums font-display text-sm font-extrabold tracking-[0.18em] text-sky-ink">
                LANGKAH {s.step} / 04
              </span>
              <h4 class="mt-2 font-display text-2xl font-extrabold tracking-[-0.02em] text-navy">
                {s.title}
              </h4>
              <p class="mt-3 text-base leading-relaxed text-body">
                {s.detail}
              </p>
            </div>
          ))
        }
      </div>

      <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
        <span class="text-xs font-medium text-body">
          Berpindah otomatis setiap 2 detik atau klik nomor langkah di atas.
        </span>
        <a
          href={content.showreel.ctaHref}
          target="_blank"
          rel="noopener noreferrer"
          class="amc-btn-primary !min-h-[44px] !px-6 !py-2.5 !text-sm"
        >
          <ActionIcon name="bot" size={17} />
          <span>{content.showreel.ctaLabel}</span>
        </a>
      </div>
    </div>
  </div>
</section>
