---
import { withBase } from '@/utils/url';

interface Props {
  targetHref: string;
  eyebrow?: string;
  title: string;
  nextLabel?: string;
  hint?: string;
  external?: boolean;
}

const {
  targetHref,
  eyebrow = 'TERUS SCROLL UNTUK LANJUT',
  title,
  nextLabel = 'Halaman Berikutnya',
  hint = 'Scroll terus ke bawah atau klik untuk langsung berpindah halaman.',
  external = false,
} = Astro.props;

const resolvedHref = external ? targetHref : withBase(targetHref);
---

<div
  id="next-page-scroll-gate"
  data-next-page-href={resolvedHref}
  data-next-page-external={external ? 'true' : 'false'}
  aria-label={`${nextLabel}: ${title}`}
  class="dark-surface relative mt-4 overflow-hidden rounded-t-[28px] bg-[#082F49] text-white sm:rounded-t-[40px]"
>
  <!-- Ambient Sky Blue aura that intensifies smoothly as overscroll charges 0% -> 100% -->
  <div
    id="next-page-glow"
    aria-hidden="true"
    style="opacity: 0.2;"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_50%_100%,rgba(56,189,248,0.52)_0%,rgba(14,165,233,0.18)_42%,rgba(8,47,73,0)_76%)] transition-opacity duration-150"
  ></div>

  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r from-transparent via-[#7DD3FC]/60 to-transparent"
    aria-hidden="true"
  ></div>

  <a
    href={resolvedHref}
    data-next-page-link
    class="group relative z-10 block px-4 pt-10 pb-10 text-white no-underline transition-colors duration-300 hover:bg-[#0C4A6E]/40 sm:px-6 md:pt-11 md:pb-11"
  >
    <div class="mx-auto max-w-amc">
      <!-- Top Lusion crosshair indicator row -->
      <div class="mb-5 flex items-center justify-between gap-4 text-[11px] font-extrabold tracking-[0.22em] text-sky-light sm:text-xs">
        <span aria-hidden="true">+</span>
        <span class="font-display text-center uppercase">{eyebrow}</span>
        <span aria-hidden="true">+</span>
      </div>

      <div class="grid grid-cols-1 items-end gap-6 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="m-0 font-display text-xs font-extrabold uppercase tracking-[0.2em] text-white/75">
            {nextLabel}
          </p>

          <h2 class="m-0 mt-2 font-display text-[clamp(2.35rem,6.4vw,5.25rem)] font-extrabold leading-[0.98] tracking-[-0.035em] text-white transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:translate-x-2">
            {title}
          </h2>
        </div>

        <div class="flex flex-col items-start gap-2.5 lg:col-span-4 lg:items-end">
          <div class="flex items-center gap-4">
            <span
              id="next-page-charge-pct"
              class="tabular-nums font-display text-sm font-extrabold tracking-[0.14em] text-sky-light"
            >
              0%
            </span>

            <!-- Circular arrow portal with SVG overscroll charge ring (r=26, C=163.36) -->
            <span class="relative inline-flex h-14 w-14 items-center justify-center rounded-full bg-white/10 text-white transition-all duration-300 group-hover:translate-x-1 group-hover:bg-sky group-hover:text-[#082F49]">
              <svg
                class="pointer-events-none absolute inset-0 h-full w-full -rotate-90"
                viewBox="0 0 56 56"
                aria-hidden="true"
              >
                <circle
                  cx="28"
                  cy="28"
                  r="26"
                  fill="none"
                  stroke="rgba(125,211,252,0.28)"
                  stroke-width="2"
                ></circle>
                <circle
                  id="next-page-ring"
                  cx="28"
                  cy="28"
                  r="26"
                  fill="none"
                  stroke="#7DD3FC"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-dasharray="163.36"
                  stroke-dashoffset="163.36"
                ></circle>
              </svg>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                {
                  external ? (
                    <path d="M7 17L17 7M9 7h8v8"></path>
                  ) : (
                    <path d="M5 12h14M13 5l7 7-7 7"></path>
                  )
                }
              </svg>
            </span>
          </div>

          <p class="m-0 max-w-xs text-xs font-medium leading-relaxed text-white/75 lg:text-right">
            {hint}
          </p>
        </div>
      </div>

      <!-- Full-width overscroll charge progress bar -->
      <div class="mt-6 h-[4px] w-full overflow-hidden rounded-full bg-white/15" aria-hidden="true">
        <div
          id="next-page-charge-bar"
          class="h-full w-full origin-left scale-x-0 rounded-full bg-gradient-to-r from-[#7DD3FC] via-[#38BDF8] to-white transition-transform duration-75 ease-out"
        ></div>
      </div>
    </div>
  </a>
</div>
