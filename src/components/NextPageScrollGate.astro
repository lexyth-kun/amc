---
import { withBase } from '@/utils/url';

interface Props {
  targetHref: string;
  eyebrow?: string;
  title: string;
  nextLabel?: string;
}

const {
  targetHref,
  eyebrow = 'TERUS SCROLL UNTUK LANJUT',
  title,
  nextLabel = 'Halaman Berikutnya',
} = Astro.props;

const resolvedHref = withBase(targetHref);
---

<section
  id="next-page-scroll-gate"
  data-next-page-href={resolvedHref}
  aria-label={`${nextLabel}: ${title}`}
  class="dark-surface relative overflow-hidden bg-[#082F49] text-white"
>
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r from-transparent via-[#38BDF8]/50 to-transparent"
    aria-hidden="true"
  ></div>

  <a
    href={resolvedHref}
    data-next-page-link
    data-page-link
    class="group relative block px-4 py-16 text-white no-underline transition-colors duration-300 hover:bg-[#0C4A6E]/55 sm:px-6 md:py-24"
  >
    <div class="mx-auto max-w-amc">
      <!-- Top crosshair row (Lusion signature + motif) -->
      <div class="mb-8 flex items-center justify-between text-xs font-bold tracking-[0.22em] text-sky-light">
        <span aria-hidden="true">+</span>
        <span class="font-display uppercase">{eyebrow}</span>
        <span aria-hidden="true">+</span>
      </div>

      <div class="grid grid-cols-1 items-end gap-6 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <p class="m-0 font-display text-xs font-extrabold uppercase tracking-[0.2em] text-white/70">
            {nextLabel}
          </p>
          <h2 class="m-0 mt-2 font-display text-[clamp(2.4rem,7vw,5.75rem)] font-extrabold leading-[0.98] tracking-[-0.03em] text-white transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:translate-x-2">
            {title}
          </h2>
        </div>

        <div class="flex flex-col items-start gap-3 lg:col-span-4 lg:items-end">
          <div class="flex items-center gap-3">
            <span
              id="next-page-charge-pct"
              class="tabular-nums font-display text-sm font-extrabold tracking-[0.12em] text-sky-light"
            >
              0%
            </span>
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-full border border-[#7DD3FC]/45 bg-white/10 text-white transition-all duration-300 group-hover:translate-x-1 group-hover:border-sky-light group-hover:bg-sky group-hover:text-[#082F49]">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 5l7 7-7 7"></path>
              </svg>
            </span>
          </div>
          <p class="m-0 text-xs font-medium text-white/75 lg:text-right">
            Scroll terus ke bawah atau klik untuk langsung berpindah halaman.
          </p>
        </div>
      </div>

      <!-- Overscroll progress bar (0% -> 100% triggers automatic Lusion page curtain) -->
      <div class="mt-8 h-[4px] w-full overflow-hidden rounded-full bg-white/15" aria-hidden="true">
        <div
          id="next-page-charge-bar"
          class="h-full w-full origin-left scale-x-0 rounded-full bg-gradient-to-r from-sky-light via-sky to-white transition-transform duration-75 ease-out"
        ></div>
      </div>
    </div>
  </a>
</section>
