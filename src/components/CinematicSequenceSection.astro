---
import content from '@/data/content.json';
import products from '@/data/products.json';
import { getProductDetailBySlug } from '@/data/product-details';
import { withBase } from '@/utils/url';

const categoryOrder = [
  'AI & Produktivitas',
  'Kreasi & Desain',
  'Hiburan & Musik',
  'VPN & Keamanan',
  'Buzzer Sosmed',
  'Top Up Game',
] as const;

const serviceGroups = categoryOrder.map((cat) => ({
  label: cat,
  items: products.allServices.filter((s) => s.category === cat),
}));
---

<section
  id="dunia-baru"
  data-bg-color="#082F49"
  class="relative bg-bg-space"
  aria-label="Sekuens cerita interaktif seluruh layanan Al Muthi Creative"
>
  <div
    id="cinematic-pin-stage"
    class="relative flex h-[100dvh] w-full items-center justify-center overflow-hidden bg-bg-space"
  >
    <canvas
      id="cinematic-canvas"
      class="absolute inset-0 z-0 block h-full w-full"
      aria-hidden="true"
    ></canvas>

    <!-- Phase 1 Copy (0% - 16%): Deep Sky-Night + Glowing Sky Orb -->
    <div
      id="cinematic-phase1"
      class="dark-surface pointer-events-none relative z-10 mx-auto max-w-4xl rounded-3xl bg-[radial-gradient(ellipse_at_center,rgba(8,47,73,0.82)_0%,rgba(8,47,73,0)_76%)] px-6 py-8 text-center"
    >
      <p class="font-display text-xs font-extrabold uppercase tracking-[0.24em] text-sky-light">
        {content.cinematic.phase1Eyebrow}
      </p>
      <h2
        id="cinematic-phase1-heading"
        class="mt-4 font-display text-[clamp(2.5rem,6.5vw,5.5rem)] font-extrabold leading-[1.04] tracking-[-0.03em] text-white"
      >
        {
          content.cinematic.phase1Headline.split(' ').map((word) => (
            <span class="word-mask mr-[0.22em] last:mr-0">
              <span class="cinematic-p1-word word-inner">{word}</span>
            </span>
          ))
        }
      </h2>
    </div>

    <!-- Phase 2 Extended All-Services Showcase (16% - 78%): All 41 Official AMC Services -->
    <div
      id="cinematic-phase2"
      style="opacity: 0; pointer-events: none;"
      class="dark-surface absolute inset-x-0 z-10 flex flex-col items-center justify-center px-4 pt-16 pb-8 sm:px-6"
    >
      <div class="w-full max-w-5xl rounded-card border border-[#38BDF8]/40 bg-[#082F49]/90 p-5 shadow-[0_24px_70px_rgba(0,0,0,0.45)] backdrop-blur-md sm:p-7">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[#38BDF8]/25 pb-4">
          <div>
            <p class="m-0 font-display text-[11px] font-extrabold uppercase tracking-[0.22em] text-sky-light">
              SELURUH LAYANAN APLIKASI AMC ({products.allServices.length} LAYANAN)
            </p>
            <p
              id="cinematic-active-category"
              class="m-0 mt-1 font-display text-lg font-extrabold text-white sm:text-2xl"
            >
              1/{serviceGroups.length} • {serviceGroups[0]?.label}
            </p>
          </div>

          <div class="flex items-center gap-1.5" aria-hidden="true">
            {
              serviceGroups.map((_, idx) => (
                <span
                  data-tunnel-dot={idx}
                  class={`h-2 rounded-full transition-all duration-300 ${
                    idx === 0 ? 'w-8 bg-sky-light' : 'w-2.5 bg-white/30'
                  }`}
                ></span>
              ))
            }
          </div>
        </div>

        <div class="mt-4 min-h-[220px] sm:min-h-[250px]">
          {
            serviceGroups.map((group, gIdx) => (
              <div
                data-tunnel-group={gIdx}
                data-tunnel-group-label={group.label}
                hidden={gIdx !== 0}
                class="grid grid-cols-2 gap-2.5 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5"
              >
                {group.items.map((service) => {
                  const detail = getProductDetailBySlug(service.slug);
                  return (
                    <a
                      href={withBase(`/produk/${service.slug}/`)}
                      data-product-link
                      data-product-title={detail?.name ?? service.name}
                      data-product-category={service.category}
                      data-product-image={withBase(detail?.heroImage ?? '/showcase/amc-ecosystem-gallery.webp')}
                      data-product-logo={withBase(service.logo)}
                      class="group flex items-center gap-2.5 rounded-2xl border border-[#38BDF8]/30 bg-white/10 p-2.5 text-white no-underline transition-all duration-200 hover:border-sky-light hover:bg-white/20"
                    >
                      <span class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-xl border border-[#BAE6FD] bg-white shadow-sm">
                        <img
                          src={withBase(service.logo)}
                          alt={`Logo ${service.name}`}
                          width="40"
                          height="40"
                          loading="lazy"
                          decoding="async"
                          class="h-full w-full object-contain"
                        />
                      </span>
                      <span class="min-w-0 truncate font-display text-xs font-bold text-white sm:text-[13px]">
                        {service.name}
                      </span>
                    </a>
                  );
                })}
              </div>
            ))
          }
        </div>

        <div class="mt-4 flex flex-col gap-2 border-t border-[#38BDF8]/25 pt-3.5 sm:flex-row sm:items-center sm:justify-between">
          <p class="m-0 text-xs font-medium text-sky-light">
            {content.cinematic.phase2Caption}
          </p>
          <div class="h-1.5 w-full overflow-hidden rounded-full bg-white/15 sm:w-44" aria-hidden="true">
            <div
              id="cinematic-showcase-bar"
              class="h-full w-full origin-left scale-x-[0.04] rounded-full bg-gradient-to-r from-sky-light to-sky"
            ></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Phase 3 -> 4 Reverse Black-Hole Whiteout & Final Reveal (90% - 100%) -->
    <div
      id="cinematic-whiteout"
      style="opacity: 0; pointer-events: none;"
      class="absolute inset-0 z-20 flex flex-col items-center justify-center bg-white px-4 text-center sm:px-6"
    >
      <div id="cinematic-phase4-copy" class="mx-auto max-w-4xl">
        <p class="eyebrow-label mb-4">DUNIA KREATIF AMC</p>
        <h2 class="font-display text-[clamp(2.4rem,6.4vw,5.4rem)] font-extrabold leading-[1.0] tracking-[-0.03em] text-navy">
          {content.cinematic.phase4Headline}
        </h2>
        <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-body sm:text-lg">
          {content.cinematic.phase4Sub}
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3.5">
          <a
            href={content.cinematic.ctaHref}
            target="_blank"
            rel="noopener noreferrer"
            data-magnetic
            class="amc-btn-primary"
          >
            {content.cinematic.ctaLabel}
          </a>
          <a
            href={withBase(content.cinematic.catalogCtaHref)}
            data-page-link
            data-magnetic
            class="amc-btn-ghost"
          >
            {content.cinematic.catalogCtaLabel}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
