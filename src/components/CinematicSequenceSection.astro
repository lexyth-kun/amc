---
import content from '@/data/content.json';
import products from '@/data/products.json';
import ActionIcon from './ActionIcon.astro';
import { getProductDetailBySlug } from '@/data/product-details';
import { withBase } from '@/utils/url';

const worldConfigs = [
  {
    category: 'AI & Produktivitas',
    shortLabel: 'AI',
    watermark: 'AI 2026',
    subtitle: 'ChatGPT, Claude, Gemini, hingga Grok siap kerja cerdas setiap hari.',
  },
  {
    category: 'Kreasi & Desain',
    shortLabel: 'Desain',
    watermark: 'KREASI',
    subtitle: 'Suite kreatif Adobe, Canva, dan CapCut untuk karya visual tanpa batas.',
  },
  {
    category: 'Hiburan & Musik',
    shortLabel: 'Hiburan',
    watermark: 'HIBURAN',
    subtitle: 'Streaming film 4K dan musik bebas iklan untuk semua perangkat.',
  },
  {
    category: 'VPN & Keamanan',
    shortLabel: 'VPN',
    watermark: 'PRIVASI',
    subtitle: 'Koneksi terenkripsi kecepatan tinggi dengan privasi terjaga penuh.',
  },
  {
    category: 'Buzzer Sosmed',
    shortLabel: 'Buzzer',
    watermark: 'BUZZER',
    subtitle: 'Dorong visibilitas konten organik di Instagram, TikTok, dan Shopee.',
  },
  {
    category: 'Top Up Game',
    shortLabel: 'Game',
    watermark: 'GAMING',
    subtitle: 'Isi diamond, Robux, hingga VP cepat masuk dalam hitungan menit.',
  },
] as const;

const serviceGroups = worldConfigs.map((cfg) => ({
  label: cfg.category,
  shortLabel: cfg.shortLabel,
  watermark: cfg.watermark,
  subtitle: cfg.subtitle,
  items: products.allServices.filter((s) => s.category === cfg.category),
}));
---

<section
  id="dunia-baru"
  data-bg-color="#082F49"
  class="relative bg-bg-space"
  aria-label="Sekuens animasi ikon dan logo seluruh layanan Al Muthi Creative"
>
  <div
    id="cinematic-pin-stage"
    class="relative flex h-[100dvh] w-full items-center justify-center overflow-hidden bg-bg-space"
  >
    <canvas
      id="cinematic-canvas"
      class="absolute inset-0 z-0 block h-full w-full"
      aria-hidden="true"
    ></canvas>

    <!-- Phase 1 Copy (0% - 16%): Deep Sky-Night + Celestial Gyro Core -->
    <div
      id="cinematic-phase1"
      class="dark-surface pointer-events-none relative z-10 mx-auto max-w-5xl bg-[radial-gradient(ellipse_at_center,rgba(8,47,73,0.78)_0%,rgba(8,47,73,0)_74%)] px-6 py-8 text-center"
    >
      <p class="font-display text-xs font-extrabold uppercase tracking-[0.24em] text-sky-light">
        {content.cinematic.phase1Eyebrow}
      </p>
      <h2
        id="cinematic-phase1-heading"
        class="mt-4 font-display text-[clamp(2.5rem,6.2vw,5.4rem)] font-extrabold leading-[1.06] tracking-[-0.03em] text-white"
      >
        {
          content.cinematic.phase1Headline.split(' ').map((word) => (
            <span class="word-mask mr-[0.22em] last:mr-0">
              <span class="cinematic-p1-word word-inner">{word}</span>
            </span>
          ))
        }
      </h2>
    </div>

    <!-- Phase 2 Multi-World Spatial Choreography (16% - 78%): Zero Cards -->
    <div
      id="cinematic-phase2"
      style="opacity: 0; pointer-events: none;"
      class="dark-surface pointer-events-none absolute inset-0 z-10 flex flex-col items-center justify-between px-4 pt-24 pb-6 sm:px-6 sm:pt-28 sm:pb-8"
    >
      <!-- Giant kinetic editorial watermark behind floating logos -->
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 z-0 flex items-center justify-center overflow-hidden select-none"
      >
        <span
          id="cinematic-world-watermark"
          class="font-display text-[clamp(4.5rem,17vw,14.5rem)] font-extrabold leading-none tracking-[-0.04em] text-white/[0.065] whitespace-nowrap will-change-transform"
        >
          {serviceGroups[0]?.watermark}
        </span>
      </div>

      <!-- Frameless editorial world HUD with subtle radial scrim for razor-sharp contrast -->
      <div class="pointer-events-none relative z-20 mx-auto max-w-2xl bg-[radial-gradient(ellipse_at_center,rgba(5,28,54,0.84)_0%,rgba(5,28,54,0)_76%)] px-8 py-2 text-center">
        <p class="m-0 font-display text-[11px] font-extrabold uppercase tracking-[0.24em] text-[#7DD3FC]">
          {products.allServices.length} LAYANAN APLIKASI PREMIUM
        </p>
        <p
          id="cinematic-active-category"
          class="m-0 mt-1 font-display text-lg font-extrabold tracking-[-0.02em] text-white sm:text-2xl"
        >
          01/0{serviceGroups.length} • {serviceGroups[0]?.label}
        </p>
        <p
          id="cinematic-active-subtitle"
          class="m-0 mt-1 text-xs font-medium text-[#BAE6FD]/95 sm:text-sm"
        >
          {serviceGroups[0]?.subtitle}
        </p>
      </div>

      <!-- Frameless spatial choreography stage: 6 distinct 3D formations across all 41 official app logos -->
      <div id="cinematic-orbital-stage" class="relative z-10 w-full flex-1">
        {
          serviceGroups.map((group, gIdx) => (
            <div
              data-tunnel-group={gIdx}
              data-tunnel-group-label={group.label}
              data-tunnel-group-subtitle={group.subtitle}
              data-tunnel-group-watermark={group.watermark}
              aria-hidden={gIdx !== 0 ? 'true' : 'false'}
              style={gIdx === 0 ? '' : 'opacity: 0; pointer-events: none;'}
              class="absolute inset-0"
            >
              {group.items.map((service, itemIdx) => {
                const detail = getProductDetailBySlug(service.slug);
                return (
                  <a
                    href={withBase(`/produk/${service.slug}/`)}
                    data-tunnel-icon
                    data-tunnel-item-idx={itemIdx}
                    data-product-link
                    data-product-title={detail?.name ?? service.name}
                    data-product-category={service.category}
                    data-product-image={withBase(detail?.heroImage ?? '/showcase/amc-ecosystem-gallery.webp')}
                    data-product-logo={withBase(service.logo)}
                    aria-label={`Lihat detail ${service.name}`}
                    title={service.name}
                    class="group absolute left-1/2 top-1/2 -ml-[26px] -mt-[26px] flex h-[52px] w-[52px] items-center justify-center rounded-2xl bg-white p-2 ring-1 ring-white/80 shadow-[0_14px_38px_rgba(56,189,248,0.42),0_0_0_5px_rgba(125,211,252,0.12)] transition-shadow duration-300 hover:z-30 hover:ring-2 hover:ring-[#BAE6FD] hover:shadow-[0_20px_50px_rgba(125,211,252,0.85),0_0_0_8px_rgba(186,230,253,0.24)] sm:-ml-[34px] sm:-mt-[34px] sm:h-[68px] sm:w-[68px] sm:p-2.5"
                    style="opacity: 0; will-change: transform, opacity;"
                  >
                    <img
                      src={withBase(service.logo)}
                      alt={`Logo ${service.name}`}
                      width="52"
                      height="52"
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-contain"
                    />
                    <span class="pointer-events-none absolute -bottom-7 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-[#041d34]/75 px-2 py-0.5 font-display text-[10px] font-bold tracking-[0.02em] text-[#E0F2FE] backdrop-blur-[2px] opacity-0 transition-opacity duration-200 sm:text-[11px] sm:opacity-95 group-hover:text-white group-hover:opacity-100 group-focus-visible:opacity-100">
                      {service.name}
                    </span>
                  </a>
                );
              })}
            </div>
          ))
        }
      </div>

      <!-- Interactive frameless 6-world jump switcher & warp hairline (zero cards) -->
      <div
        id="cinematic-world-nav"
        class="relative z-20 flex flex-col items-center gap-2.5"
        style="pointer-events: none;"
      >
        <div
          role="tablist"
          aria-label="Pilih kategori dunia layanan AMC"
          class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-2"
        >
          {
            serviceGroups.map((group, idx) => (
              <button
                type="button"
                role="tab"
                aria-selected={idx === 0 ? 'true' : 'false'}
                data-tunnel-dot={idx}
                class={`inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 font-display text-[10px] font-bold uppercase tracking-[0.12em] transition-all duration-300 sm:px-3 sm:py-1.5 sm:text-[11px] ${
                  idx === 0
                    ? 'border-[#7DD3FC]/70 bg-[#38BDF8]/25 text-white shadow-[0_0_20px_rgba(56,189,248,0.35)]'
                    : 'border-white/15 bg-white/[0.04] text-white/60 hover:border-white/35 hover:text-white'
                }`}
              >
                <span class="text-[9px] text-[#7DD3FC]">0{idx + 1}</span>
                <span>{group.shortLabel}</span>
              </button>
            ))
          }
        </div>
        <div class="h-[2px] w-44 overflow-hidden rounded-full bg-white/15 sm:w-64" aria-hidden="true">
          <div
            id="cinematic-showcase-bar"
            class="h-full w-full origin-left scale-x-[0.04] rounded-full bg-gradient-to-r from-[#BAE6FD] via-[#7DD3FC] to-[#38BDF8]"
          ></div>
        </div>
      </div>
    </div>

    <!-- Phase 3 -> 4 Reverse Black-Hole Whiteout & Final Reveal (90% - 100%) -->
    <div
      id="cinematic-whiteout"
      style="opacity: 0; pointer-events: none;"
      class="absolute inset-0 z-20 flex flex-col items-center justify-center bg-white px-4 text-center sm:px-6"
    >
      <div id="cinematic-phase4-copy" class="mx-auto max-w-4xl">
        <p class="eyebrow-label mb-4">DUNIA KREATIF AMC</p>
        <h2 class="font-display text-[clamp(2.4rem,6.4vw,5.4rem)] font-extrabold leading-[1.0] tracking-[-0.03em] text-navy">
          {content.cinematic.phase4Headline}
        </h2>
        <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-body sm:text-lg">
          {content.cinematic.phase4Sub}
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3.5">
          <a
            href={content.cinematic.ctaHref}
            target="_blank"
            rel="noopener noreferrer"
            data-magnetic
            class="amc-btn-primary"
          >
            <ActionIcon name="bot" size={18} />
            <span>{content.cinematic.ctaLabel}</span>
          </a>
          <a
            href={withBase(content.cinematic.catalogCtaHref)}
            data-page-link
            data-magnetic
            class="amc-btn-ghost"
          >
            {content.cinematic.catalogCtaLabel}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
