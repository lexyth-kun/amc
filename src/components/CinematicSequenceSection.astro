---
import content from '@/data/content.json';
import products from '@/data/products.json';
import ActionIcon from './ActionIcon.astro';
import { getProductDetailBySlug } from '@/data/product-details';
import { withBase } from '@/utils/url';

const categoryOrder = [
  'AI & Produktivitas',
  'Kreasi & Desain',
  'Hiburan & Musik',
  'VPN & Keamanan',
  'Buzzer Sosmed',
  'Top Up Game',
] as const;

const serviceGroups = categoryOrder.map((cat) => ({
  label: cat,
  items: products.allServices.filter((s) => s.category === cat),
}));
---

<section
  id="dunia-baru"
  data-bg-color="#082F49"
  class="relative bg-bg-space"
  aria-label="Sekuens animasi ikon dan logo seluruh layanan Al Muthi Creative"
>
  <div
    id="cinematic-pin-stage"
    class="relative flex h-[100dvh] w-full items-center justify-center overflow-hidden bg-bg-space"
  >
    <canvas
      id="cinematic-canvas"
      class="absolute inset-0 z-0 block h-full w-full"
      aria-hidden="true"
    ></canvas>

    <!-- Phase 1 Copy (0% - 16%): Deep Sky-Night + Glowing Sky Orb -->
    <div
      id="cinematic-phase1"
      class="dark-surface pointer-events-none relative z-10 mx-auto max-w-4xl bg-[radial-gradient(ellipse_at_center,rgba(8,47,73,0.72)_0%,rgba(8,47,73,0)_74%)] px-6 py-8 text-center"
    >
      <p class="font-display text-xs font-extrabold uppercase tracking-[0.24em] text-sky-light">
        {content.cinematic.phase1Eyebrow}
      </p>
      <h2
        id="cinematic-phase1-heading"
        class="mt-4 font-display text-[clamp(2.5rem,6.5vw,5.5rem)] font-extrabold leading-[1.04] tracking-[-0.03em] text-white"
      >
        {
          content.cinematic.phase1Headline.split(' ').map((word) => (
            <span class="word-mask mr-[0.22em] last:mr-0">
              <span class="cinematic-p1-word word-inner">{word}</span>
            </span>
          ))
        }
      </h2>
    </div>

    <!-- Phase 2 Pure Orbital Logo & Icon Animation (16% - 78%): Zero Cards -->
    <div
      id="cinematic-phase2"
      style="opacity: 0; pointer-events: none;"
      class="dark-surface pointer-events-none absolute inset-0 z-10 flex flex-col items-center justify-between px-4 pt-24 pb-8 sm:px-6 sm:pt-28 sm:pb-10"
    >
      <!-- Subtle frameless top label -->
      <div class="pointer-events-none relative z-20 text-center">
        <p class="m-0 font-display text-[11px] font-extrabold uppercase tracking-[0.24em] text-sky-light">
          {products.allServices.length} LAYANAN APLIKASI PREMIUM
        </p>
        <p
          id="cinematic-active-category"
          class="m-0 mt-1 font-display text-base font-extrabold tracking-[-0.01em] text-white sm:text-xl"
        >
          1/{serviceGroups.length} • {serviceGroups[0]?.label}
        </p>
      </div>

      <!-- Frameless orbital stage: pure animated official app icons orbiting the center Sky Blue orb -->
      <div id="cinematic-orbital-stage" class="relative w-full flex-1">
        {
          serviceGroups.map((group, gIdx) => (
            <div
              data-tunnel-group={gIdx}
              data-tunnel-group-label={group.label}
              aria-hidden={gIdx !== 0 ? 'true' : 'false'}
              style={gIdx === 0 ? '' : 'opacity: 0; pointer-events: none;'}
              class="absolute inset-0"
            >
              {group.items.map((service, itemIdx) => {
                const detail = getProductDetailBySlug(service.slug);
                return (
                  <a
                    href={withBase(`/produk/${service.slug}/`)}
                    data-tunnel-icon
                    data-tunnel-item-idx={itemIdx}
                    data-product-link
                    data-product-title={detail?.name ?? service.name}
                    data-product-category={service.category}
                    data-product-image={withBase(detail?.heroImage ?? '/showcase/amc-ecosystem-gallery.webp')}
                    data-product-logo={withBase(service.logo)}
                    aria-label={`Lihat detail ${service.name}`}
                    title={service.name}
                    class="group absolute left-1/2 top-1/2 -ml-[26px] -mt-[26px] flex h-[52px] w-[52px] items-center justify-center rounded-2xl bg-white p-2 shadow-[0_14px_38px_rgba(56,189,248,0.42)] transition-shadow duration-300 hover:shadow-[0_18px_48px_rgba(125,211,252,0.72)] sm:-ml-9 sm:-mt-9 sm:h-[72px] sm:w-[72px] sm:p-2.5"
                    style="opacity: 0; will-change: transform, opacity;"
                  >
                    <img
                      src={withBase(service.logo)}
                      alt={`Logo ${service.name}`}
                      width="56"
                      height="56"
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-contain"
                    />
                    <span class="pointer-events-none absolute -bottom-7 left-1/2 -translate-x-1/2 whitespace-nowrap font-display text-[11px] font-bold tracking-[0.02em] text-sky-light opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100">
                      {service.name}
                    </span>
                  </a>
                );
              })}
            </div>
          ))
        }
      </div>

      <!-- Minimal frameless bottom progress indicator (zero card) -->
      <div class="pointer-events-none relative z-20 flex flex-col items-center gap-2.5">
        <div class="flex items-center gap-1.5" aria-hidden="true">
          {
            serviceGroups.map((_, idx) => (
              <span
                data-tunnel-dot={idx}
                class={`h-1.5 rounded-full transition-all duration-300 ${
                  idx === 0 ? 'w-7 bg-sky-light' : 'w-2 bg-white/30'
                }`}
              ></span>
            ))
          }
        </div>
        <div class="h-[2px] w-40 overflow-hidden rounded-full bg-white/15 sm:w-56" aria-hidden="true">
          <div
            id="cinematic-showcase-bar"
            class="h-full w-full origin-left scale-x-[0.04] rounded-full bg-gradient-to-r from-sky-light to-sky"
          ></div>
        </div>
      </div>
    </div>

    <!-- Phase 3 -> 4 Reverse Black-Hole Whiteout & Final Reveal (90% - 100%) -->
    <div
      id="cinematic-whiteout"
      style="opacity: 0; pointer-events: none;"
      class="absolute inset-0 z-20 flex flex-col items-center justify-center bg-white px-4 text-center sm:px-6"
    >
      <div id="cinematic-phase4-copy" class="mx-auto max-w-4xl">
        <p class="eyebrow-label mb-4">DUNIA KREATIF AMC</p>
        <h2 class="font-display text-[clamp(2.4rem,6.4vw,5.4rem)] font-extrabold leading-[1.0] tracking-[-0.03em] text-navy">
          {content.cinematic.phase4Headline}
        </h2>
        <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-body sm:text-lg">
          {content.cinematic.phase4Sub}
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3.5">
          <a
            href={content.cinematic.ctaHref}
            target="_blank"
            rel="noopener noreferrer"
            data-magnetic
            class="amc-btn-primary"
          >
            <ActionIcon name="bot" size={18} />
            <span>{content.cinematic.ctaLabel}</span>
          </a>
          <a
            href={withBase(content.cinematic.catalogCtaHref)}
            data-page-link
            data-magnetic
            class="amc-btn-ghost"
          >
            {content.cinematic.catalogCtaLabel}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
