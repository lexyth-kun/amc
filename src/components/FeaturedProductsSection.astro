---
import products from '@/data/products.json';
import content from '@/data/content.json';
import { getProductDetailBySlug } from '@/data/product-details';
import { formatRupiah } from '@/utils/format';
import { withBase } from '@/utils/url';
import BlueLine from './BlueLine.astro';
---

<section
  id="produk"
  data-bg-color="#FFFFFF"
  class="bg-bg py-16 md:py-28"
  aria-labelledby="featured-heading"
>
  <div class="mx-auto max-w-amc px-4 sm:px-6">
    <BlueLine className="mb-12 md:mb-16" />

    <div class="mb-12 flex flex-col justify-between gap-6 lg:flex-row lg:items-end md:mb-16">
      <div>
        <p class="eyebrow-label mb-3">{content.featuredSection.eyebrow}</p>
        <h2
          id="featured-heading"
          data-split-words
          class="font-display text-[clamp(2.25rem,5.4vw,4.5rem)] font-extrabold leading-[1.02] tracking-[-0.03em] text-navy"
        >
          {content.featuredSection.headline}
        </h2>
      </div>

      <div class="flex flex-col items-start gap-3 lg:max-w-md lg:items-end lg:text-right">
        <p class="m-0 text-base leading-relaxed text-body">
          {content.featuredSection.description}
        </p>
        <a
          href={withBase(content.featuredSection.allProductsHref)}
          data-page-link
          class="inline-flex min-h-[44px] items-center font-display text-sm font-extrabold text-sky-ink no-underline transition-transform duration-300 hover:translate-x-1"
        >
          {content.featuredSection.allProductsLabel}
        </a>
      </div>
    </div>

    <!-- 3 cols desktop / 2 cols tablet / 1 col mobile (Lusion showcase card rhythm) -->
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        products.featuredProducts.map((product) => {
          const detail = getProductDetailBySlug(product.slug);
          const heroImage = withBase(detail?.heroImage ?? '/showcase/amc-ecosystem-gallery.webp');
          const logoUrl = withBase(product.logo);
          const detailHref = withBase(`/produk/${product.slug}/`);
          return (
            <a
              href={detailHref}
              data-product-card
              data-product-link
              data-product-title={product.name}
              data-product-category={detail?.category ?? 'LAYANAN UNGGULAN AMC'}
              data-product-image={heroImage}
              data-product-logo={logoUrl}
              class="group relative flex flex-col justify-between rounded-card border border-line bg-white p-4 text-ink no-underline shadow-sm transition-[box-shadow,border-color] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:border-sky-deep hover:shadow-amc-hover sm:p-5"
              style="transform-style: preserve-3d; will-change: transform;"
            >
              <div>
                <!-- Lusion-style 16:10 3D Showcase Media Frame -->
                <div
                  data-card-visual
                  class="relative mb-5 overflow-hidden rounded-[18px] border border-line/90 bg-bg-alt"
                >
                  <img
                    src={heroImage}
                    alt={detail?.heroImageAlt ?? `Visual 3D ${product.name}`}
                    width="1280"
                    height="800"
                    loading="lazy"
                    decoding="async"
                    class="aspect-[16/10] h-auto w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.07]"
                  />

                  {product.badge && (
                    <span
                      class={`absolute left-3 top-3 z-10 inline-flex items-center rounded-lg px-2.5 py-1 font-display text-[10px] font-extrabold tracking-[0.08em] shadow-sm ${
                        product.badge === 'PALING LARIS'
                          ? 'bg-sale-ink text-white'
                          : 'bg-sky text-[#082F49]'
                      }`}
                    >
                      {product.badge}
                    </span>
                  )}

                  <span class="absolute right-3 top-3 z-10 rounded-lg border border-line bg-white/95 px-2.5 py-1 font-display text-[11px] font-bold text-navy shadow-sm">
                    {product.duration}
                  </span>

                  <!-- Official pure-white platform logo badge floating bottom-left -->
                  <div
                    data-card-media
                    class="absolute bottom-3 left-3 z-10 flex h-12 w-12 items-center justify-center overflow-hidden rounded-xl border border-line bg-white p-1.5 shadow-md transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-105"
                  >
                    <img
                      src={logoUrl}
                      alt={`Logo ${product.name}`}
                      width="48"
                      height="48"
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-contain"
                    />
                  </div>
                </div>

                <p class="m-0 font-display text-[11px] font-extrabold uppercase tracking-[0.14em] text-sky-ink">
                  {detail?.category ?? 'LAYANAN PREMIUM'}
                </p>

                <!-- Lusion dot-to-arrow horizontal title shift on hover -->
                <div class="mt-1.5 flex items-center gap-2">
                  <span
                    aria-hidden="true"
                    class="inline-flex h-2 w-2 shrink-0 rounded-full bg-sky transition-all duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:w-5 group-hover:bg-sky-deep"
                  ></span>
                  <h3 class="m-0 font-display text-xl font-extrabold tracking-[-0.02em] text-navy transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:translate-x-1">
                    {product.name}
                  </h3>
                </div>

                <p class="mt-2 text-sm leading-relaxed text-body">
                  {product.description}
                </p>
              </div>

              <div class="mt-5 flex items-center justify-between border-t border-line pt-4">
                <div>
                  <span class="block text-[11px] font-bold uppercase tracking-[0.12em] text-body">
                    Harga {product.duration}
                  </span>
                  <span class="tabular-nums font-display text-2xl font-extrabold tracking-[-0.02em] text-navy transition-colors duration-300 group-hover:text-sky-ink">
                    {formatRupiah(product.price)}
                  </span>
                </div>

                <span class="inline-flex min-h-[44px] items-center justify-center gap-1.5 rounded-full border border-line bg-bg-alt px-4 py-2 font-display text-sm font-extrabold text-navy transition-all duration-300 group-hover:border-transparent group-hover:bg-gradient-to-r group-hover:from-sky-light group-hover:to-sky group-hover:text-[#082F49] group-hover:shadow-[0_10px_24px_rgba(2,132,199,0.28)]">
                  <span>Detail</span>
                  <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-0.5">→</span>
                </span>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
