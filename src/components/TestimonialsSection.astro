---
import content from '@/data/content.json';
import BlueLine from './BlueLine.astro';
---

<section
  id="testimoni"
  data-bg-color="#FFFFFF"
  class="bg-bg py-16 md:py-28"
  aria-labelledby="testimonials-heading"
>
  <div class="mx-auto max-w-amc px-4 sm:px-6">
    <BlueLine className="mb-12 md:mb-16" />

    <div class="mb-10 flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
      <div>
        <p class="eyebrow-label mb-3">{content.testimonials.eyebrow}</p>
        <h2
          id="testimonials-heading"
          data-split-words
          class="font-display text-[clamp(2rem,4.8vw,3.85rem)] font-extrabold leading-[1.04] tracking-[-0.03em] text-navy"
        >
          {content.testimonials.headline}
        </h2>
        <p class="mt-3 max-w-2xl text-base leading-relaxed text-body">
          {content.testimonials.subnote}
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <a
          href={content.testimonials.reviewsUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-magnetic
          class="amc-btn-primary"
        >
          {content.testimonials.reviewsCtaLabel}
        </a>
      </div>
    </div>

    <!-- Verified Rating Portal Card -> https://order.amc.web.id/#ulasan -->
    <div class="rounded-card border border-line bg-bg-alt p-6 sm:p-8 lg:p-10">
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-center">
        <div class="rounded-2xl border border-line bg-white p-6 shadow-amc lg:col-span-4">
          <div role="img" class="flex items-center gap-1 text-amber-500" aria-label="Rating 4.8 dari 5 bintang">
            {Array.from({ length: 5 }).map(() => (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2l2.9 6.26L22 9.27l-5 4.87 1.18 6.86L12 17.77l-6.18 3.23L7 14.14 2 9.27l7.1-1.01L12 2z"></path>
              </svg>
            ))}
          </div>
          <p class="tabular-nums mt-4 mb-0 font-display text-5xl font-extrabold leading-none tracking-[-0.03em] text-navy">
            {content.testimonials.ratingValue}
          </p>
          <p class="mt-2 mb-0 text-sm font-bold text-sky-ink">
            {content.testimonials.reviewCountLabel}
          </p>
          <p class="mt-1 mb-0 text-xs font-semibold text-body">
            {content.testimonials.ordersCountLabel}
          </p>

          <a
            href={content.testimonials.reviewsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-flex min-h-[44px] w-full items-center justify-center rounded-full border border-line bg-bg-alt px-4 py-2.5 font-display text-sm font-extrabold text-navy no-underline transition-colors hover:border-sky-deep hover:bg-bg-deep"
          >
            Buka order.amc.web.id/#ulasan →
          </a>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3 lg:col-span-8">
          {
            content.testimonials.highlights.map((item, idx) => (
              <div class="flex flex-col justify-between rounded-2xl border border-line bg-white p-5">
                <div>
                  <span class="tabular-nums inline-flex h-8 w-8 items-center justify-center rounded-xl bg-bg-deep font-display text-xs font-extrabold text-sky-ink">
                    0{idx + 1}
                  </span>
                  <h3 class="mt-4 font-display text-base font-extrabold tracking-[-0.02em] text-navy">
                    {item.title}
                  </h3>
                  <p class="mt-2 text-sm leading-relaxed text-body">
                    {item.desc}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
