---
import content from '@/data/content.json';
import BlueLine from './BlueLine.astro';
---

<section
  id="intro"
  data-bg-color="#F4F8FF"
  class="bg-bg-alt py-16 md:py-28"
  aria-labelledby="intro-heading"
>
  <div class="mx-auto max-w-amc px-4 sm:px-6">
    <BlueLine className="mb-12 md:mb-16" />

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="eyebrow-label mb-4">{content.intro.eyebrow}</p>
        <h2
          id="intro-heading"
          data-split-words
          class="font-display text-[clamp(2.25rem,5.4vw,4.5rem)] font-extrabold leading-[1.02] tracking-[-0.03em] text-navy"
        >
          {content.intro.headline}
        </h2>
      </div>

      <div data-fade-up class="lg:col-span-5 lg:pb-1">
        <p class="text-base leading-[1.7] text-body sm:text-lg">
          {content.intro.body}
        </p>

        <a
          href={content.intro.linkHref}
          data-scroll-to={content.intro.linkHref}
          class="mt-6 inline-flex min-h-[44px] items-center gap-2 font-display text-sm font-extrabold tracking-[-0.01em] text-amc no-underline transition-transform duration-300 hover:translate-x-1"
        >
          <span>{content.intro.linkLabel}</span>
        </a>
      </div>
    </div>
  </div>
</section>
