---
import content from '@/data/content.json';
import ActionIcon from './ActionIcon.astro';
---

<section
  id="cta-akhir"
  data-bg-color="#E0F2FE"
  class="relative overflow-hidden bg-gradient-to-b from-white via-bg-alt to-bg-deep py-20 md:py-32"
  aria-labelledby="final-cta-heading"
>
  <svg
    class="pointer-events-none absolute -left-4 top-10 h-28 w-28 -rotate-12 opacity-70 sm:left-12 sm:h-36 sm:w-36"
    viewBox="0 0 64 64"
    fill="none"
    stroke="#7DD3FC"
    stroke-width="2.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <rect x="8" y="18" width="48" height="28" rx="14" fill="#F0F9FF"></rect>
    <path d="M22 27v10M17 32h10"></path>
    <circle cx="42" cy="29" r="2.2" fill="#7DD3FC"></circle>
    <circle cx="47" cy="34" r="2.2" fill="#7DD3FC"></circle>
  </svg>

  <svg
    class="pointer-events-none absolute -right-4 bottom-10 h-28 w-28 rotate-12 opacity-70 sm:right-14 sm:h-36 sm:w-36"
    viewBox="0 0 64 64"
    fill="none"
    stroke="#7DD3FC"
    stroke-width="2.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 26l28-10v28L12 34v-8z" fill="#F0F9FF"></path>
    <path d="M18 35l4 13"></path>
    <path d="M46 23a10 10 0 0 1 0 14M51 19a16 16 0 0 1 0 22"></path>
  </svg>

  <div class="relative z-10 mx-auto max-w-4xl px-4 text-center sm:px-6">
    <p class="eyebrow-label mb-4">{content.finalCta.eyebrow}</p>

    <h2
      id="final-cta-heading"
      data-split-words
      class="font-display text-[clamp(2.6rem,7vw,5.8rem)] font-extrabold leading-[0.98] tracking-[-0.03em] text-navy"
    >
      {content.finalCta.headlineBefore}{' '}
      <span class="amc-text-gradient">{content.finalCta.headlineHighlight}</span>{' '}
      {content.finalCta.headlineAfter}
    </h2>

    <p class="mx-auto mt-6 max-w-xl text-base leading-[1.7] text-body sm:text-lg">
      {content.finalCta.subheadline}
    </p>

    <div data-stagger-group class="mt-9 flex flex-wrap items-center justify-center gap-4">
      <a
        href={content.finalCta.primaryHref}
        target="_blank"
        rel="noopener noreferrer"
        data-stagger-card
        data-magnetic
        class="amc-btn-primary"
      >
        <ActionIcon name="bot" size={18} />
        <span>{content.finalCta.primaryLabel}</span>
      </a>

      <a
        href={content.finalCta.waHref}
        target="_blank"
        rel="noopener noreferrer"
        data-stagger-card
        data-magnetic
        class="amc-btn-ghost"
      >
        <ActionIcon name="shop" size={18} />
        <span>{content.finalCta.waLabel}</span>
      </a>
    </div>
  </div>
</section>
