---
import content from '@/data/content.json';
import BlueLine from './BlueLine.astro';
import NextPageScrollGate from './NextPageScrollGate.astro';
import { withBase } from '@/utils/url';
import { resolveFooterNextPage } from '@/utils/next-page-scroll';

interface Props {
  nextTargetHref?: string;
  nextTitle?: string;
  nextEyebrow?: string;
  nextLabel?: string;
  nextHint?: string;
  nextExternal?: boolean;
}

const autoNext = resolveFooterNextPage(
  Astro.url.pathname,
  import.meta.env.BASE_URL || '/'
);

const {
  nextTargetHref = autoNext.href,
  nextTitle = autoNext.title,
  nextEyebrow = autoNext.eyebrow,
  nextLabel = autoNext.nextLabel,
  nextHint = autoNext.hint,
  nextExternal = autoNext.external,
} = Astro.props;
---

<footer
  id="kontak"
  data-bg-color="#FFFFFF"
  class="bg-bg pt-14 md:pt-20"
  role="contentinfo"
>
  <div data-footer-reveal class="mx-auto max-w-amc px-4 sm:px-6">
    <BlueLine className="mb-10 md:mb-12" />

    <!-- Lusion-style Asymmetric Editorial Footer Grid (Zero corporate sitemap columns) -->
    <div class="grid grid-cols-1 gap-y-10 sm:grid-cols-2 lg:grid-cols-12 lg:gap-x-10">
      <!-- Col 1: Brand Identity + Minimal Socials -->
      <div class="lg:col-span-3">
        <a
          href={withBase('/')}
          data-page-link
          class="inline-flex min-h-[44px] items-center gap-2.5 text-navy no-underline"
        >
          <span class="flex h-9 w-9 items-center justify-center overflow-hidden rounded-xl border border-line bg-white">
            <img
              src={withBase('/logo-amc.webp')}
              alt="Logo Al Muthi Creative"
              width="36"
              height="36"
              loading="lazy"
              class="h-full w-full object-cover"
            />
          </span>
          <span class="font-display text-sm font-extrabold tracking-[-0.01em] text-navy">
            Al Muthi Creative
          </span>
        </a>

        <p class="m-0 mt-3 text-sm leading-[1.7] text-body">
          Indonesia<br />
          Admin & Bot 24 Jam<br />
          41+ Aplikasi Premium
        </p>

        <ul class="m-0 mt-5 flex list-none flex-col gap-0 p-0">
          <li>
            <a
              href={content.footer.contacts.instagramHref}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-[44px] items-center font-display text-sm font-bold text-navy no-underline transition-colors hover:text-sky-ink"
            >
              Instagram ↗
            </a>
          </li>
          <li>
            <a
              href={content.footer.contacts.waBotHref}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-[44px] items-center font-display text-sm font-bold text-navy no-underline transition-colors hover:text-sky-ink"
            >
              Bot WhatsApp ↗
            </a>
          </li>
          <li>
            <a
              href="https://order.amc.web.id/#ulasan"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-[44px] items-center font-display text-sm font-bold text-navy no-underline transition-colors hover:text-sky-ink"
            >
              Ulasan Asli ↗
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 2: Direct Contact Inquiries (Order via Bot WA, CS strictly for support) -->
      <div class="flex flex-col gap-5 lg:col-span-3">
        <div>
          <p class="m-0 text-xs font-semibold text-body">Order Otomatis (Bot WA 24 Jam)</p>
          <a
            href={content.footer.contacts.waBotHref}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-0.5 inline-flex min-h-[44px] items-center font-display text-sm font-bold text-navy no-underline transition-colors hover:text-sky-ink"
          >
            {content.footer.contacts.waBotDisplay}
          </a>
        </div>

        <div>
          <p class="m-0 text-xs font-semibold text-body">Bantuan & Klaim Garansi (CS)</p>
          <a
            href={content.footer.contacts.waAdminHref}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-0.5 inline-flex min-h-[44px] items-center font-display text-sm font-bold text-navy no-underline transition-colors hover:text-sky-ink"
          >
            {content.footer.contacts.waAdminDisplay}
          </a>
        </div>

        <div>
          <p class="m-0 text-xs font-semibold text-body">Email</p>
          <a
            href={content.footer.contacts.emailHref}
            class="mt-0.5 inline-flex min-h-[44px] items-center font-display text-sm font-bold text-navy no-underline transition-colors hover:text-sky-ink"
          >
            {content.footer.contacts.emailDisplay}
          </a>
        </div>
      </div>

      <!-- Col 3 (Right Half): Monumental Lusion-Style Frameless Info WA Opt-In -> Direct to Bot WA -->
      <div class="sm:col-span-2 lg:col-span-5 lg:col-start-8">
        <form class="js-newsletter-form" novalidate>
          <label
            for="footer-promo-phone"
            class="block font-display text-[clamp(1.7rem,3vw,2.5rem)] font-extrabold leading-[1.08] tracking-[-0.03em] text-navy"
          >
            Dapatkan info promo<br />
            <span class="amc-text-gradient">& stok terbaru</span>
          </label>

          <div class="mt-6 flex items-center gap-2 rounded-full border border-line bg-bg-alt p-1.5 pl-5 transition-all duration-300 focus-within:border-sky-deep focus-within:bg-white focus-within:ring-2 focus-within:ring-[#0284C7]/25">
            <input
              id="footer-promo-phone"
              name="phone"
              type="tel"
              inputmode="tel"
              autocomplete="tel"
              placeholder={content.footer.newsletterPlaceholder}
              class="min-h-[48px] w-full flex-1 border-0 bg-transparent text-sm font-medium text-ink outline-none placeholder:text-[#475569]/70 focus-visible:outline-none"
            />
            <button
              type="submit"
              aria-label={content.footer.newsletterButton}
              title={content.footer.newsletterButton}
              class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[#7DD3FC] to-[#38BDF8] text-[#082F49] shadow-sm transition-all duration-300 hover:scale-105 hover:from-[#38BDF8] hover:to-[#0EA5E9]"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 5l7 7-7 7"></path>
              </svg>
              <span class="sr-only">{content.footer.newsletterButton}</span>
            </button>
          </div>

          <p class="js-newsletter-feedback mt-2.5 text-xs leading-relaxed text-body" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>

    <!-- Ultra-Minimal 3-Part Lusion Credit Line + Circular Back-to-Top -->
    <div class="mt-10 flex flex-col items-start justify-between gap-4 border-t border-line py-5 text-xs font-medium text-body sm:flex-row sm:items-center md:mt-12">
      <span class="font-display font-bold uppercase tracking-[0.06em] text-navy">
        ©2026 AL MUTHI CREATIVE
      </span>

      <a
        href="https://order.amc.web.id"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-[44px] items-center gap-1.5 text-body no-underline transition-colors hover:text-sky-ink"
      >
        <span>Web Shop:</span>
        <span class="font-display font-bold text-navy">order.amc.web.id</span>
      </a>

      <div class="flex items-center gap-4">
        <span>Dibuat oleh Adrian Ali Muthi</span>
        <button
          type="button"
          id="footer-back-to-top"
          aria-label="Kembali ke paling atas halaman"
          title="Kembali ke atas"
          class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-line bg-white text-navy transition-all duration-300 hover:-translate-y-0.5 hover:border-sky-deep hover:bg-bg-alt hover:text-sky-ink"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 19V5M5 12l7-7 7 7"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Seamless Integrated Lusion Auto-Scroll Next Page Portal -->
  <NextPageScrollGate
    targetHref={nextTargetHref}
    eyebrow={nextEyebrow}
    title={nextTitle}
    nextLabel={nextLabel}
    hint={nextHint}
    external={nextExternal}
  />
</footer>
