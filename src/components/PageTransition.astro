---
---

<div
  id="page-transition-curtain"
  hidden
  class="pointer-events-none fixed inset-0 z-[9995] bg-gradient-to-b from-sky-light via-sky to-sky-deep"
  aria-hidden="true"
>
  <div class="flex h-full items-center justify-center">
    <span class="font-display text-sm font-extrabold uppercase tracking-[0.28em] text-[#082F49]">
      AL MUTHI CREATIVE
    </span>
  </div>
</div>

<!-- Lusion-style shared-element spatial morph portal for product card -> detail page -->
<div
  id="product-transition-portal"
  hidden
  class="pointer-events-none fixed z-[9996] overflow-hidden bg-bg-alt shadow-[0_32px_90px_rgba(8,47,73,0.28)]"
  aria-hidden="true"
>
  <img
    id="portal-hero-img"
    src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
    alt=""
    width="1280"
    height="800"
    class="h-full w-full object-cover"
  />
  <div
    class="absolute inset-0 bg-gradient-to-t from-[#082F49]/85 via-[#082F49]/25 to-[#38BDF8]/15"
  ></div>
  <div
    id="portal-content"
    class="absolute inset-0 flex flex-col items-center justify-center px-6 text-center opacity-0"
  >
    <span
      id="portal-logo-wrap"
      class="mb-4 flex h-16 w-16 items-center justify-center overflow-hidden rounded-2xl border border-white/80 bg-white p-2 shadow-lg"
    >
      <img
        id="portal-logo-img"
        src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
        alt=""
        width="48"
        height="48"
        class="h-full w-full object-contain"
      />
    </span>
    <span
      id="portal-category"
      class="font-display text-[11px] font-extrabold uppercase tracking-[0.24em] text-sky-light"
    ></span>
    <span
      id="portal-title"
      class="mt-2 font-display text-[clamp(1.75rem,4.5vw,3.75rem)] font-extrabold leading-[1.04] tracking-[-0.03em] text-white"
    ></span>
  </div>
</div>
