---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlueLine from '@/components/BlueLine.astro';
import ActionIcon from '@/components/ActionIcon.astro';
import FooterSection from '@/components/FooterSection.astro';
import aboutData from '@/data/about.json';
import products from '@/data/products.json';
import { getProductDetailBySlug } from '@/data/product-details';
import { withBase } from '@/utils/url';

const soloCreator = aboutData.creators[0];

const supportedBrandSlugs = [
  'chatgpt',
  'claude',
  'gemini',
  'supergrok',
  'adobe',
  'adobe-express',
  'canva',
  'capcut',
  'netflix',
  'youtube',
  'spotify',
  'applemusic',
  'hbomax',
  'primevideo',
  'discord',
  'zoom',
  'vpnexpress',
  'vpnsurfshark',
];

const supportedBrands = supportedBrandSlugs
  .map((slug) => products.allServices.find((s) => s.slug === slug))
  .filter((item): item is (typeof products.allServices)[number] => Boolean(item));

const resolvedReviewWaves = aboutData.reviewWaves.map((wave) => ({
  ...wave,
  href: withBase(wave.href),
  reviews: wave.reviews.map((review) => ({
    ...review,
    logo: withBase(review.logo),
  })),
}));

const initialFrontWave = resolvedReviewWaves[0];
const initialBackWave = resolvedReviewWaves[1];
const fiveStarIndices = [0, 1, 2, 3, 4];
---

<BaseLayout
  title={aboutData.seo.title}
  description={aboutData.seo.description}
  currentPath="/about/"
  showPreloader={false}
>
  <!-- ======================================================================
       01. ABOUT HERO: Interactive Movable 3D Sphere Particles + Manifesto
       ====================================================================== -->
  <section
    id="about-hero"
    data-bg-color="#FFFFFF"
    data-spheres-stage
    aria-labelledby="about-hero-heading"
    class="amc-spheres-stage relative flex min-h-[92dvh] flex-col justify-between overflow-hidden bg-gradient-to-b from-white via-[#F0F9FF]/75 to-white pt-28 pb-12 md:pt-36 md:pb-16"
  >
    <canvas
      id="about-particles-canvas"
      data-about-spheres
      data-spheres-density="hero"
      class="pointer-events-none absolute inset-0 z-0 h-full w-full"
      aria-hidden="true"
    ></canvas>

    <div class="relative z-10 mx-auto flex w-full max-w-amc flex-1 flex-col justify-between px-4 sm:px-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <a
            href={withBase('/')}
            data-page-link
            class="inline-flex min-h-[44px] items-center gap-2 rounded-full border border-line bg-white/95 px-4 py-2 font-display text-xs font-extrabold tracking-[0.06em] text-navy no-underline shadow-sm transition-all duration-300 hover:-translate-x-0.5 hover:border-sky-deep hover:bg-bg-alt hover:text-sky-ink"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M19 12H5M12 19l-7-7 7-7"></path>
            </svg>
            <span>Beranda</span>
          </a>
          <p class="eyebrow-label m-0">{aboutData.hero.eyebrow}</p>
        </div>

        <div class="flex items-center gap-2.5">
          <button
            type="button"
            id="about-particles-pause"
            aria-pressed="false"
            class="min-h-[40px] rounded-full border border-line bg-white/95 px-3.5 py-1.5 font-display text-[11px] font-bold text-body shadow-sm transition-colors hover:border-sky-deep hover:text-navy"
          >
            Jeda Bola 3D
          </button>
        </div>
      </div>

      <div class="my-10 md:my-14">
        <h1
          id="about-hero-heading"
          class="m-0 font-display text-[clamp(2.65rem,8.4vw,6.8rem)] font-extrabold leading-[0.94] tracking-[-0.035em] text-navy"
        >
          {
            aboutData.hero.lines.map((line, idx) => (
              <span data-split-words class="block">
                {idx === 3 ? <span class="amc-text-gradient">{line}</span> : line}
              </span>
            ))
          }
        </h1>

        <div class="mt-10 grid grid-cols-1 items-end gap-8 lg:grid-cols-12">
          <p class="m-0 max-w-2xl rounded-2xl bg-white/70 p-4 text-base leading-relaxed text-body backdrop-blur-sm sm:p-5 sm:text-xl lg:col-span-7">
            {aboutData.hero.lead}
          </p>

          <div class="flex items-center justify-between gap-4 border-t border-line pt-4 text-xs font-extrabold tracking-[0.2em] text-sky-ink lg:col-span-5 lg:justify-end">
            <span aria-hidden="true">•</span>
            <span class="font-display uppercase">{aboutData.hero.scrollCue}</span>
            <span aria-hidden="true">•</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================================================================
       02. SOLO CREATOR HOLOGRAM CHAMBER: [[ 001 ]] Adrian Ali Muthi (1 / 1)
       ====================================================================== -->
  <section
    id="founder"
    data-bg-color="#F0F9FF"
    aria-labelledby="founder-heading"
    class="scroll-mt-24 bg-bg-alt py-20 md:py-32"
  >
    <div class="mx-auto max-w-amc px-4 sm:px-6">
      <BlueLine className="mb-12 md:mb-16" />

      <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-14">
        <!-- Left Lusion Interactive 3D Hologram Chamber (Strictly 1 Person: Adrian Ali Muthi) -->
        <div class="lg:col-span-5" data-fade-up>
          <div
            id="founder-hologram-card"
            class="amc-holo-card relative overflow-hidden rounded-[2rem] border border-[#38BDF8]/45 bg-[#041C2C] p-5 text-white shadow-[0_28px_70px_rgba(8,47,73,0.28)] sm:p-6"
          >
            <!-- Subtle Holographic Scanlines & Pointer Iridescent Sheen -->
            <div class="amc-holo-scanlines pointer-events-none absolute inset-0 z-10 opacity-75" aria-hidden="true"></div>
            <div class="amc-holo-iridescence pointer-events-none absolute inset-0 z-10" aria-hidden="true"></div>

            <!-- Corner Reticle Brackets -->
            <span aria-hidden="true" class="pointer-events-none absolute left-3 top-3 z-20 h-4 w-4 border-l-2 border-t-2 border-[#7DD3FC]/75"></span>
            <span aria-hidden="true" class="pointer-events-none absolute right-3 top-3 z-20 h-4 w-4 border-r-2 border-t-2 border-[#7DD3FC]/75"></span>
            <span aria-hidden="true" class="pointer-events-none absolute bottom-3 left-3 z-20 h-4 w-4 border-b-2 border-l-2 border-[#7DD3FC]/75"></span>
            <span aria-hidden="true" class="pointer-events-none absolute bottom-3 right-3 z-20 h-4 w-4 border-b-2 border-r-2 border-[#7DD3FC]/75"></span>

            <!-- Hologram Top Telemetry Header -->
            <div class="relative z-20 mb-4 flex items-center justify-between gap-2 border-b border-[#38BDF8]/25 px-2 pb-3 pt-1 font-display text-[10px] font-extrabold tracking-[0.14em] text-[#7DD3FC] sm:text-[11px] sm:tracking-[0.16em]">
              <span class="shrink-0 whitespace-nowrap">[[ {soloCreator.index} ]]</span>
              <span class="inline-flex items-center gap-1.5 text-right">
                <span class="h-2 w-2 shrink-0 rounded-full bg-[#38BDF8] shadow-[0_0_10px_#38BDF8]" aria-hidden="true"></span>
                <span>{soloCreator.hologramTag}</span>
              </span>
            </div>

            <!-- Live 3D Hologram Projection Viewport -->
            <div class="relative z-20 overflow-hidden rounded-2xl border border-[#38BDF8]/30 bg-gradient-to-b from-[#07263D] via-[#051F33] to-[#031320]">
              <canvas
                id="founder-hologram-canvas"
                data-photo-src={withBase(soloCreator.photo)}
                class="block h-[360px] w-full sm:h-[400px]"
                role="img"
                aria-label="Foto profil hologram 3D interaktif pendiri tunggal Al Muthi Creative, Adrian Ali Muthi"
              ></canvas>

              <!-- Floating AMC Crest + Monogram Badge inside Hologram -->
              <div class="pointer-events-none absolute left-4 top-4 flex items-center gap-2.5">
                <span class="flex h-10 w-10 items-center justify-center overflow-hidden rounded-xl border border-[#7DD3FC]/60 bg-white/95 p-1 shadow-[0_0_20px_rgba(56,189,248,0.35)]">
                  <img
                    src={withBase('/logo-amc.webp')}
                    alt="Logo Al Muthi Creative"
                    width="36"
                    height="36"
                    loading="lazy"
                    class="h-full w-full object-cover"
                  />
                </span>
                <span class="rounded-lg border border-[#7DD3FC]/40 bg-[#082F49]/85 px-2.5 py-1 font-display text-[11px] font-extrabold tracking-[0.16em] text-[#E0F2FE]">
                  {soloCreator.monogram}
                </span>
              </div>

              <div class="pointer-events-none absolute right-4 top-4 rounded-full border border-[#38BDF8]/40 bg-[#082F49]/80 px-2.5 py-1 font-display text-[10px] font-extrabold uppercase tracking-[0.16em] text-[#7DD3FC]">
                3D HOLO
              </div>

              <!-- Hologram Identity Readout Plate -->
              <div class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-[#031320] via-[#041C2C]/85 to-transparent p-4 sm:p-5">
                <p class="m-0 font-display text-[10px] font-extrabold uppercase tracking-[0.22em] text-[#7DD3FC]">
                  FOUNDER & SOLE CREATOR
                </p>
                <p class="m-0 mt-1 font-display text-2xl font-extrabold tracking-[-0.02em] text-white">
                  {soloCreator.name}
                </p>
                <p class="m-0 mt-1 text-[11px] font-semibold text-[#BAE6FD]">
                  {soloCreator.hologramHint}
                </p>
              </div>
            </div>

            <div class="relative z-20 mt-4 flex items-center justify-between text-xs font-bold text-[#BAE6FD]">
              <span>Al Muthi Creative • Indonesia</span>
              <a
                href="https://www.instagram.com/almuthi_creative"
                target="_blank"
                rel="noopener noreferrer"
                class="font-display font-extrabold text-[#7DD3FC] no-underline hover:text-white hover:underline"
              >
                @almuthi_creative →
              </a>
            </div>
          </div>
        </div>

        <!-- Right Editorial Narrative -->
        <div class="lg:col-span-7">
          <div class="mb-4 inline-flex items-center gap-3 font-display text-sm font-extrabold tracking-[0.18em] text-sky-ink">
            <span class="shrink-0 whitespace-nowrap">[[ {soloCreator.index} ]]</span>
            <span class="h-[1px] w-10 shrink-0 bg-sky-deep" aria-hidden="true"></span>
            <span class="uppercase">DI BALIK AL MUTHI CREATIVE</span>
          </div>

          <h2
            id="founder-heading"
            data-split-words
            class="m-0 font-display text-[clamp(2.3rem,5.4vw,4.5rem)] font-extrabold leading-[1.0] tracking-[-0.03em] text-navy"
          >
            {soloCreator.name}
          </h2>

          <p class="mt-3 font-display text-base font-extrabold text-sky-ink sm:text-lg">
            {soloCreator.role}
          </p>

          <p data-fade-up class="mt-6 text-base leading-relaxed text-body sm:text-lg">
            {soloCreator.summary}
          </p>

          <p data-fade-up class="mt-4 text-base leading-relaxed text-body sm:text-lg">
            {soloCreator.philosophy}
          </p>

          <div data-fade-up class="mt-8 flex flex-wrap items-center gap-3.5">
            <a
              href="https://wa.me/27748304118?text=menu"
              target="_blank"
              rel="noopener noreferrer"
              data-magnetic
              class="amc-btn-primary"
            >
              <ActionIcon name="bot" size={18} />
              <span>Order Via Bot WA</span>
            </a>
            <a
              href={withBase('/produk/')}
              data-page-link
              data-magnetic
              class="amc-btn-ghost"
            >
              <span>Jelajahi 41+ Layanan</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================================================================
       03. PLATFORM ECOSYSTEM GRID (Lusion "BRANDS WE WORK WITH")
       ====================================================================== -->
  <section
    id="ekosistem"
    data-bg-color="#FFFFFF"
    aria-labelledby="platforms-heading"
    class="scroll-mt-24 bg-bg py-20 md:py-28"
  >
    <div class="mx-auto max-w-amc px-4 sm:px-6">
      <BlueLine className="mb-12 md:mb-16" />

      <div class="mb-12 grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <p class="eyebrow-label mb-3">{aboutData.platformsSection.eyebrow}</p>
          <h2
            id="platforms-heading"
            data-split-words
            class="m-0 font-display text-[clamp(2.1rem,5vw,4.1rem)] font-extrabold leading-[1.02] tracking-[-0.03em] text-navy"
          >
            {aboutData.platformsSection.headline}
          </h2>
        </div>
        <div class="lg:col-span-5">
          <p class="m-0 text-base leading-relaxed text-body">
            {aboutData.platformsSection.sub}
          </p>
        </div>
      </div>

      <div
        data-stagger-group
        class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6"
      >
        {
          supportedBrands.map((brand) => {
            const detail = getProductDetailBySlug(brand.slug);
            return (
              <a
                href={withBase(`/produk/${brand.slug}/`)}
                data-stagger-card
                data-product-link
                data-product-title={detail?.name ?? brand.name}
                data-product-category={brand.category}
                data-product-image={withBase(detail?.heroImage ?? '/showcase/amc-ecosystem-gallery.webp')}
                data-product-logo={withBase(brand.logo)}
                class="group flex flex-col items-center justify-center gap-3 rounded-2xl border border-line bg-white p-5 text-center text-navy no-underline transition-all duration-300 hover:-translate-y-1 hover:border-sky-deep hover:shadow-amc"
              >
                <span class="flex h-12 w-12 items-center justify-center overflow-hidden rounded-xl border border-line bg-white p-1.5">
                  <img
                    src={withBase(brand.logo)}
                    alt={`Logo resmi ${brand.name}`}
                    width="48"
                    height="48"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-contain transition-transform duration-300 group-hover:scale-110"
                  />
                </span>
                <span class="font-display text-xs font-extrabold tracking-[-0.01em] text-navy group-hover:text-sky-ink">
                  {brand.name}
                </span>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- ======================================================================
       04. REAL MILESTONES LEDGER (Lusion "Awards 58" Architectural Ledger)
       ====================================================================== -->
  <section
    id="rekam-jejak"
    data-bg-color="#F0F9FF"
    aria-labelledby="milestones-heading"
    class="scroll-mt-24 bg-bg-alt py-20 md:py-28"
  >
    <div class="mx-auto max-w-amc px-4 sm:px-6">
      <BlueLine className="mb-12 md:mb-16" />

      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <div class="lg:sticky lg:top-28">
            <p class="eyebrow-label mb-3">{aboutData.milestones.eyebrow}</p>
            <h2
              id="milestones-heading"
              data-split-words
              class="m-0 font-display text-[clamp(2.2rem,4.5vw,3.8rem)] font-extrabold leading-[1.0] tracking-[-0.03em] text-navy"
            >
              {aboutData.milestones.headline}
            </h2>

            <div class="mt-6 flex items-baseline gap-2">
              <span class="tabular-nums font-display text-[clamp(4.2rem,9vw,7.5rem)] font-extrabold leading-none tracking-[-0.04em] amc-text-gradient">
                {aboutData.milestones.totalDisplay}
              </span>
              <span class="font-display text-2xl font-extrabold text-navy">/5</span>
            </div>
            <p class="mt-2 text-sm font-semibold text-body">
              {aboutData.milestones.totalLabel}
            </p>

            <a
              href="https://order.amc.web.id/#ulasan"
              target="_blank"
              rel="noopener noreferrer"
              class="amc-btn-ghost mt-6 !min-h-[44px] !px-5 !py-2.5 !text-xs"
            >
              <span>Verifikasi di order.amc.web.id/#ulasan →</span>
            </a>
          </div>
        </div>

        <div class="space-y-10 lg:col-span-8">
          {
            aboutData.milestones.groups.map((group) => (
              <div data-fade-up>
                <h3 class="m-0 mb-4 font-display text-lg font-extrabold tracking-[-0.02em] text-navy sm:text-xl">
                  {group.title}
                </h3>
                <ul class="m-0 list-none divide-y divide-line border-y border-line p-0">
                  {group.rows.map((row) => (
                    <li class="grid grid-cols-12 items-baseline gap-3 py-4 transition-colors duration-200 hover:bg-white/70 sm:px-3">
                      <span class="col-span-3 tabular-nums font-display text-base font-extrabold text-sky-ink sm:col-span-2 sm:text-lg">
                        {row.code}
                      </span>
                      <span class="col-span-9 font-display text-sm font-extrabold text-navy sm:col-span-5 sm:text-base">
                        {row.label}
                      </span>
                      <span class="col-span-12 text-xs font-medium text-body sm:col-span-5 sm:text-right sm:text-sm">
                        {row.note}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ======================================================================
       05. AREA OF EXPERTISE -> Lusion 3D Scroll-Flip Real Buyer Reviews Deck
           Wave 01: Adobe CC (3 reviews)
           Wave 02: ChatGPT, Claude & Gemini (3 reviews)
           Wave 03: CapCut, Canva & Wink (3 reviews)
       ====================================================================== -->
  <section
    id="ulasan-layanan"
    data-bg-color="#FFFFFF"
    data-active-wave="0"
    data-active-wave-id="adobe-cc"
    aria-labelledby="review-deck-heading"
    class="relative bg-bg"
  >
    <div
      id="review-deck-stage"
      class="flex min-h-[100svh] flex-col justify-center py-20 lg:py-14"
    >
      <div class="mx-auto w-full max-w-amc px-4 sm:px-6">
        <BlueLine className="mb-8 md:mb-10" />

        <!-- Top Header + 3 Clickable Service Wave Tabs -->
        <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
          <div class="max-w-2xl">
            <p class="eyebrow-label mb-2.5">{aboutData.reviewDeckSection.eyebrow}</p>
            <h2
              id="review-deck-heading"
              data-split-words
              class="m-0 font-display text-[clamp(2.1rem,5vw,4.1rem)] font-extrabold leading-[1.0] tracking-[-0.03em] text-navy"
            >
              {aboutData.reviewDeckSection.headline}
            </h2>
            <p class="m-0 mt-3 text-sm leading-relaxed text-body sm:text-base">
              {aboutData.reviewDeckSection.sub}
            </p>
          </div>

          <!-- 3 Service Cluster Flip Controls -->
          <div class="flex flex-col items-start gap-3 lg:items-end">
            <div class="flex flex-wrap gap-2" role="group" aria-label="Pilih kelompok ulasan layanan">
              {
                resolvedReviewWaves.map((wave, idx) => (
                  <button
                    type="button"
                    data-review-wave-tab={String(idx)}
                    aria-pressed={idx === 0 ? 'true' : 'false'}
                    class:list={['amc-wave-tab', idx === 0 && 'is-active']}
                  >
                    <span class="mr-1.5 opacity-75">{wave.code}</span>
                    <span>{wave.shortLabel}</span>
                  </button>
                ))
              }
            </div>

            <!-- Thin Scroll Flip Progress Track -->
            <div class="h-1.5 w-full max-w-[260px] overflow-hidden rounded-full bg-[#E0F2FE]">
              <div
                id="review-deck-progress-bar"
                class="h-full w-full origin-left rounded-full bg-gradient-to-r from-[#38BDF8] to-[#0284C7]"
                style="transform: scaleX(0.08);"
              ></div>
            </div>
          </div>
        </div>

        <!-- Active Wave Descriptor Strip -->
        <div class="mt-7 flex flex-col justify-between gap-2 rounded-2xl border border-[#BAE6FD] bg-[#F0F9FF] px-4 py-3.5 sm:flex-row sm:items-center sm:px-5">
          <div class="min-w-0">
            <p
              id="review-deck-active-label"
              class="m-0 font-display text-sm font-extrabold tracking-[0.02em] text-navy"
            >
              {initialFrontWave.code} / 03 • {initialFrontWave.label}
            </p>
            <p id="review-deck-active-summary" class="m-0 mt-0.5 text-xs font-medium text-body sm:text-sm">
              {initialFrontWave.summary}
            </p>
          </div>
          <a
            id="review-deck-active-link"
            href={initialFrontWave.href}
            data-page-link
            class="inline-flex min-h-[36px] shrink-0 items-center font-display text-xs font-extrabold text-sky-ink no-underline hover:underline"
          >
            Lihat detail {initialFrontWave.shortLabel} →
          </a>
        </div>

        <!-- 3 Double-Sided 3D Flip Review Cards -->
        <div class="mt-6 grid grid-cols-1 gap-5 lg:grid-cols-3">
          {
            [0, 1, 2].map((slotIdx) => {
              const frontReview = initialFrontWave.reviews[slotIdx];
              const backReview = initialBackWave.reviews[slotIdx];
              return (
                <div data-review-slot={String(slotIdx)} class="amc-flip-scene">
                  <div data-flip-card data-flip-angle="0" class="amc-flip-card">
                    <!-- FRONT FACE (Wave 01 Adobe CC -> swaps while hidden at 180deg to Wave 03 CapCut, Canva & Wink) -->
                    <article
                      data-flip-front
                      class="amc-flip-face amc-flip-front border border-[#BAE6FD] bg-white p-6 shadow-[0_14px_34px_rgba(8,47,73,0.08)]"
                    >
                      <div class="amc-flip-sheen" data-flip-sheen aria-hidden="true"></div>
                      <div>
                        <div class="flex items-center justify-between gap-3">
                          <div class="flex items-center gap-3 min-w-0">
                            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-line bg-white p-1.5 shadow-sm">
                              <img
                                data-face-logo
                                src={frontReview.logo}
                                alt={`Logo ${frontReview.service}`}
                                width="32"
                                height="32"
                                loading="lazy"
                                class="h-full w-full object-contain"
                              />
                            </span>
                            <div class="min-w-0">
                              <span
                                data-face-service
                                class="block truncate font-display text-xs font-extrabold text-navy"
                              >
                                {frontReview.service}
                              </span>
                              <div class="mt-0.5 flex items-center gap-0.5 text-[#0284C7]" aria-label="Rating 5 dari 5 bintang">
                                {fiveStarIndices.map(() => (
                                  <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                    <path d="M12 2.4l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.3l-5.9 3.1 1.2-6.5-4.8-4.6 6.6-.9L12 2.4z"></path>
                                  </svg>
                                ))}
                              </div>
                            </div>
                          </div>

                          <span
                            data-face-code
                            class="shrink-0 rounded-full border border-[#BAE6FD] bg-[#F0F9FF] px-2.5 py-1 font-display text-[11px] font-extrabold tracking-[0.12em] text-sky-ink"
                          >
                            {initialFrontWave.code} / 03
                          </span>
                        </div>

                        <blockquote
                          data-face-quote
                          class="m-0 mt-5 font-display text-base font-bold leading-[1.55] tracking-[-0.01em] text-navy sm:text-[1.06rem]"
                        >
                          "{frontReview.quote}"
                        </blockquote>
                      </div>

                      <div class="mt-6 flex items-end justify-between gap-3 border-t border-line pt-4">
                        <div class="min-w-0">
                          <p data-face-author class="m-0 truncate font-display text-sm font-extrabold text-navy">
                            {frontReview.author}
                          </p>
                          <p data-face-source class="m-0 mt-0.5 truncate text-[11px] font-semibold text-body">
                            {frontReview.source}
                          </p>
                        </div>
                        <span data-face-date class="shrink-0 text-[11px] font-bold text-sky-ink">
                          {frontReview.date}
                        </span>
                      </div>
                    </article>

                    <!-- BACK FACE (Wave 02 ChatGPT, Claude & Gemini, revealed cleanly at rotateY 180deg) -->
                    <article
                      data-flip-back
                      class="amc-flip-face amc-flip-back border border-[#7DD3FC] bg-gradient-to-br from-white via-[#F0F9FF] to-[#E0F2FE] p-6 shadow-[0_14px_34px_rgba(8,47,73,0.10)]"
                    >
                      <div>
                        <div class="flex items-center justify-between gap-3">
                          <div class="flex items-center gap-3 min-w-0">
                            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#7DD3FC] bg-white p-1.5 shadow-sm">
                              <img
                                data-face-logo
                                src={backReview.logo}
                                alt={`Logo ${backReview.service}`}
                                width="32"
                                height="32"
                                loading="lazy"
                                class="h-full w-full object-contain"
                              />
                            </span>
                            <div class="min-w-0">
                              <span
                                data-face-service
                                class="block truncate font-display text-xs font-extrabold text-navy"
                              >
                                {backReview.service}
                              </span>
                              <div class="mt-0.5 flex items-center gap-0.5 text-[#0284C7]" aria-label="Rating 5 dari 5 bintang">
                                {fiveStarIndices.map(() => (
                                  <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                    <path d="M12 2.4l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.3l-5.9 3.1 1.2-6.5-4.8-4.6 6.6-.9L12 2.4z"></path>
                                  </svg>
                                ))}
                              </div>
                            </div>
                          </div>

                          <span
                            data-face-code
                            class="shrink-0 rounded-full border border-[#7DD3FC] bg-white px-2.5 py-1 font-display text-[11px] font-extrabold tracking-[0.12em] text-sky-ink"
                          >
                            {initialBackWave.code} / 03
                          </span>
                        </div>

                        <blockquote
                          data-face-quote
                          class="m-0 mt-5 font-display text-base font-bold leading-[1.55] tracking-[-0.01em] text-navy sm:text-[1.06rem]"
                        >
                          "{backReview.quote}"
                        </blockquote>
                      </div>

                      <div class="mt-6 flex items-end justify-between gap-3 border-t border-[#BAE6FD] pt-4">
                        <div class="min-w-0">
                          <p data-face-author class="m-0 truncate font-display text-sm font-extrabold text-navy">
                            {backReview.author}
                          </p>
                          <p data-face-source class="m-0 mt-0.5 truncate text-[11px] font-semibold text-body">
                            {backReview.source}
                          </p>
                        </div>
                        <span data-face-date class="shrink-0 text-[11px] font-bold text-sky-ink">
                          {backReview.date}
                        </span>
                      </div>
                    </article>
                  </div>
                </div>
              );
            })
          }
        </div>

        <!-- Bottom Verification Bar -->
        <div class="mt-7 flex flex-col items-start justify-between gap-3 text-xs font-semibold text-body sm:flex-row sm:items-center">
          <span>{aboutData.reviewDeckSection.scrollHint}</span>
          <a
            href="https://order.amc.web.id/#ulasan"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-[40px] items-center font-display font-extrabold text-sky-ink no-underline hover:underline"
          >
            Buka seluruh 1.266 ulasan di order.amc.web.id/#ulasan →
          </a>
        </div>
      </div>
    </div>

    <!-- Pre-resolved wave dataset for client 3D flip engine -->
    <script
      id="about-review-waves-data"
      type="application/json"
      set:html={JSON.stringify(resolvedReviewWaves)}
    ></script>
  </section>

  <!-- ======================================================================
       06. FINAL CTA: "Ayo Order Sekarang!" + Interactive Movable 3D Spheres
           (Replaces Lusion "Let's work together!")
       ====================================================================== -->
  <section
    id="about-order-cta"
    data-bg-color="#E0F2FE"
    data-spheres-stage
    aria-labelledby="about-order-cta-heading"
    class="amc-spheres-stage relative flex min-h-[78dvh] items-center overflow-hidden bg-gradient-to-b from-white via-[#F0F9FF] to-[#E0F2FE] py-24 md:py-32"
  >
    <canvas
      id="about-cta-particles-canvas"
      data-about-spheres
      data-spheres-density="cta"
      class="pointer-events-none absolute inset-0 z-0 h-full w-full"
      aria-hidden="true"
    ></canvas>

    <div class="relative z-10 mx-auto max-w-4xl px-4 text-center sm:px-6">
      <p class="eyebrow-label mb-4">{aboutData.orderCta.eyebrow}</p>

      <h2
        id="about-order-cta-heading"
        class="m-0 font-display text-[clamp(3rem,9vw,7.4rem)] font-extrabold leading-[1.04] tracking-[-0.035em] text-navy"
      >
        <span data-split-words class="block">{aboutData.orderCta.headlineLine1}</span>
        <span data-split-words class="block">
          <span class="amc-text-gradient">{aboutData.orderCta.headlineLine2}</span>
        </span>
      </h2>

      <p class="mx-auto mt-6 max-w-xl rounded-2xl bg-white/75 px-5 py-3 text-base leading-[1.7] text-body backdrop-blur-sm sm:text-lg">
        {aboutData.orderCta.subheadline}
      </p>

      <div data-stagger-group class="mt-9 flex flex-wrap items-center justify-center gap-4">
        <a
          href={aboutData.orderCta.botHref}
          target="_blank"
          rel="noopener noreferrer"
          data-stagger-card
          data-magnetic
          class="amc-btn-primary"
        >
          <ActionIcon name="bot" size={18} />
          <span>{aboutData.orderCta.botLabel}</span>
        </a>

        <a
          href={aboutData.orderCta.shopHref}
          target="_blank"
          rel="noopener noreferrer"
          data-stagger-card
          data-magnetic
          class="amc-btn-ghost"
        >
          <ActionIcon name="shop" size={18} />
          <span>{aboutData.orderCta.shopLabel}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Minimalist Lusion Footer with Auto-Scroll Portal straight to https://order.amc.web.id -->
  <FooterSection />
</BaseLayout>
