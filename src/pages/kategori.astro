---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CategoriesSection from '@/components/CategoriesSection.astro';
import FinalCtaSection from '@/components/FinalCtaSection.astro';
import FooterSection from '@/components/FooterSection.astro';
import products from '@/data/products.json';

const groups = [
  'AI & Produktivitas',
  'Kreasi & Desain',
  'Hiburan & Musik',
  'VPN & Keamanan',
  'Buzzer Sosmed',
  'Top Up Game',
] as const;
---

<BaseLayout
  title="Kategori Layanan Digital – Al Muthi Creative"
  description="Jelajahi kategori AI Premium, Desain & Editing, Streaming & Musik, VPN, Buzzer Sosial Media, dan Top Up Game di Al Muthi Creative."
  currentPath="/kategori/"
  showPreloader={false}
>
  <section class="bg-gradient-to-b from-bg-alt via-white to-bg-alt pt-32 pb-6 md:pt-40 md:pb-8">
    <div class="mx-auto max-w-amc px-4 sm:px-6">
      <p class="eyebrow-label mb-3">NAVIGASI KATEGORI AMC</p>
      <h1 class="max-w-4xl font-display text-[clamp(2.4rem,6vw,4.8rem)] font-extrabold leading-[1.0] tracking-[-0.03em] text-navy">
        Semua <span class="amc-text-gradient">Kategori Layanan</span> dalam Satu Toko.
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-body sm:text-lg">
        Dari aplikasi AI dan desain kreatif sampai hiburan, VPN, buzzer sosmed, dan top up game instan.
      </p>
    </div>
  </section>

  <CategoriesSection />

  <section class="bg-bg py-16 md:py-24" aria-label="Rincian layanan per kategori">
    <div class="mx-auto max-w-amc px-4 sm:px-6">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          groups.map((group) => {
            const list = products.allServices.filter((s) => s.category === group);
            return (
              <div class="rounded-card border border-line bg-bg-alt p-6">
                <div class="mb-4 flex items-center justify-between gap-2">
                  <h2 class="m-0 font-display text-xl font-extrabold text-navy">{group}</h2>
                  <span class="rounded-lg border border-line bg-white px-2.5 py-1 font-display text-xs font-bold text-sky-ink">
                    {list.length} layanan
                  </span>
                </div>
                <div class="flex flex-wrap gap-2">
                  {list.map((svc) => (
                    <a
                      href={svc.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex min-h-[44px] items-center gap-2 rounded-xl border border-line bg-white px-3 py-1.5 text-xs font-bold text-navy no-underline transition-colors hover:border-sky-deep hover:text-sky-ink"
                    >
                      <img src={svc.logo} alt="" width="24" height="24" loading="lazy" class="h-6 w-6 rounded-md bg-white object-contain" />
                      <span>{svc.name}</span>
                    </a>
                  ))}
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <FinalCtaSection />
  <FooterSection />
</BaseLayout>
